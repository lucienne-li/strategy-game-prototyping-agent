{"schema_version":"1.0","sample_id":"scale-sbrophy-dev-realms-of-iron-0143","messages":[{"role":"user","content":"Implement the `resolveCombat` function in TypeScript, following the provided signature and constraints."},{"role":"assistant","content":"export function resolveCombat(\n  params: CombatParams,\n  isMajor: boolean = false\n): CombatResult {\n  const { attackerStrength, defenderStrength, fortBonus, terrainModifier, seed } = params;\n  const rng = createSeededRng(seed);\n\n  if (attackerStrength <= 0 && defenderStrength <= 0) {\n    return { winner: 'defender', attackerCasualties: 0, defenderCasualties: 0, rounds: 1 };\n  }\n  if (attackerStrength <= 0) {\n    return { winner: 'defender', attackerCasualties: 0, defenderCasualties: 0, rounds: 1 };\n  }\n  if (defenderStrength <= 0) {\n    return { winner: 'attacker', attackerCasualties: 0, defenderCasualties: 0, rounds: 1 };\n  }\n\n  // Effective defender strength includes fort bonus and terrain modifier\n  const effectiveDefender = defenderStrength + fortBonus + terrainModifier;\n\n  if (!isMajor) {\n    return resolveNormalBattle(attackerStrength, effectiveDefender, defenderStrength, rng);\n  }\n\n  return resolveMajorBattle(attackerStrength, effectiveDefender, defenderStrength, rng);\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["CombatParams","CombatResult","Effective"]},"metadata":{"source_repo":"SBrophy-dev/Realms-of-Iron","source_commit":"db62fde05f0837d8e05ce5aff49360b4eb01d4b8","source_path":"src/engine/combat.ts","source_lines":"23-48","repository_family_id":"github-family:SBrophy-dev/Realms-of-Iron","license":"MIT","category":"tactics","granularity":"G1","symbol":"resolveCombat","target_sha256":"17881e77d8ec417574905ce6976fab511d2271a7b9f494702e3723d8ca42f63c","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `resolveCombat` function in TypeScrip