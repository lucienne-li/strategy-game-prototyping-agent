{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0122","messages":[{"role":"user","content":"Implement the `LaserAmmo` class in TypeScript, ensuring it extends `Ammo` and adheres to the specified requirements."},{"role":"assistant","content":"export class LaserAmmo extends Ammo {\n  constructor(ammoName: AmmoName, ammoDictEntity: AmmoDictEntity) {\n    super(ammoName, ammoDictEntity);\n  }\n\n  getDerivedCssProps() {\n    return {\n      ...super.getDerivedCssProps(),\n\n      left: this.startPosition.screen.x + constants.tileSize.width / 2,\n      top: this.startPosition.screen.y + constants.tileSize.height / 2,\n      height:\n        getDistanceBetweenGridPoints(this.startPosition.grid, this.targetPosition.grid) *\n        constants.wireframeTileSize.width,\n      transform: `rotateX(60deg) rotateZ(${this.angle.deg - 45}deg) translateZ(20px)`,\n    };\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["Ammo","AmmoName","AmmoDictEntity"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/engine/weapon/laser/LaserAmmoFactory.ts","source_lines":"6-23","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G2","symbol":"LaserAmmo","target_sha256":"6e22d1e252aa864fab5c6be8ade33d0595fe9b4599fb648d9422c57dd48dcafa","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `LaserAmmo` class in TypeScript, ensuring it extends `Ammo` and adheres to the specified requirements.\"\n}\n```","batch_seconds":18.402},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0122","target_sha256":"6e22d1e252aa864fab5c6be8ade33d0595fe9b4599fb648d9422c57dd48dcafa","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_sec