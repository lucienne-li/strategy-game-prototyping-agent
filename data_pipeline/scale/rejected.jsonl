{"schema_version":"1.0","sample_id":"scale-emp3thy-nuclearwar-0184","messages":[{"role":"user","content":"Implement the `aggressive` function in TypeScript, following the provided signature and instructions."},{"role":"assistant","content":"export function aggressive(state: GameState, id: LeaderId = 'player1'): Order[] {\n  const me = state.leaders[id];\n  if (!me || !me.alive) return [];\n  const orders: Order[] = [];\n  const tryAdd = adder(state, id, me.ap, orders);\n  const others = aliveOthers(state, id);\n  if (others.length === 0) return orders;\n\n  if (state.round === 1) tryAdd({ kind: 'build-factory' });\n\n  const target = others.reduce((best, t) =>\n    state.leaders[t].population > state.leaders[best].population ? t : best,\n  );\n\n  let progressed = true;\n  while (progressed) {\n    progressed = false;\n    if (tryAdd({ kind: 'build-missile' })) progressed = true;\n    if (tryAdd({ kind: 'build-warhead', yield: 'small' })) progressed = true;\n    if (tryAdd({ kind: 'launch', target, delivery: 'missile', warhead: 'small', targetType: 'people' })) {\n      progressed = true;\n    }\n  }\n  return orders;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameState","LeaderId","Order"]},"metadata":{"source_repo":"emp3thy/nuclearwar","source_commit":"bf38ff3b07d65b6a4ddb1206c3a75a5d291f695b","source_path":"scripts/playability/humanPolicy.ts","source_lines":"167-191","repository_family_id":"github-family:emp3thy/nuclearwar","license":"MIT","category":"tactics","granularity":"G1","symbol":"aggressive","target_sha256":"8ed1ce854578e28f90d177232430b34396d9d4f3a7f66ef637fc8760949461fc","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `aggressive` function in TypeScript, following the provided signature and instructions.\"\n}\n```","batch_seconds":27.243},"independent_review":{"unit_id":"scale-emp3thy-nuclearwar-