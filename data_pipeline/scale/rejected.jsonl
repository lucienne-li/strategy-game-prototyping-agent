{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0236","messages":[{"role":"user","content":"Implement the `applyAdventureAction` function in TypeScript, following the provided signature and instructions."},{"role":"assistant","content":"export function applyAdventureAction(\n  state: GameState,\n  action: AdventureAction,\n  ctx: GameContext,\n  quien: PlayerId,\n  alcance?: Reachable,\n): void {\n  if (state.pendingBattle !== null) {\n    throw new Error('hay una batalla pendiente de resolver');\n  }\n  // La partida terminada y el turno ajeno los dice `turnBlocker`, que es donde\n  // vive la frase: aquÃ­ no se reescribe ninguna de las dos.\n  const bloqueo = turnBlocker(state, quien);\n  if (bloqueo !== null) throw new Error(bloqueo);\n\n  // QuiÃ©n actÃºa se anota ANTES de la acciÃ³n: `end_turn` cambia `state.current`,\n  // y el que acaba de meter su hÃ©roe en el castillo es el jugador saliente.\n  const actor = currentPlayer(state).id;\n  aplicar(state, action, ctx, alcance);\n\n  // Y nada se aprende despuÃ©s del final. `aplicar` puede terminar la partida\n  // â€”capturar el Ãºltimo castillo del rival lo haceâ€”, y esta sincronÃ­a iba\n  // detrÃ¡s sin preguntar: en 34 de 200 semillas la crÃ³nica acababa con Â«Fin de\n  // la partidaÂ» y DEBAJO Â«El jugador 1 aprende: Prisa, LentitudÂ», que ademÃ¡s se\n  // pinta asÃ­ en pantalla. La regla que rompÃ­a estÃ¡ escrita en `settleBattle`\n  // â€”`game_over` es el ÃšLTIMO hecho del registroâ€” y no la vigilaba nadie;\n  // ahora sÃ­ (`test/invariantes.test.ts`).\n  if (state.finished === null) syncSpellbooks(state, actor);\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameState","AdventureAction","GameContext","PlayerId","Reachable","Error","La","Qui","ANTES","Y","Fin","DEBAJO"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/core/state/game.ts","source_lines":"656-684","