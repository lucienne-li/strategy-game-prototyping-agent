{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0111","messages":[{"role":"user","content":"Implement the `setUnitDead` function in the `GameMap` class, which takes a `state` object and an `action` object as parameters. The function should update the `isDead`, `blocksRays`, and `action` properties of the `entity` in the `state`. If the `entity` does not exist, it"},{"role":"assistant","content":"export function setUnitDead(state: GameMap, action: SetUnitDeadReducerAction): GameMap {\n  const entity = state.getUnitById(action.entityId);\n\n  if (entity) {\n    entity.isDead = action.isDead;\n    entity.blocksRays = !action.isDead;\n    entity.setAction(action.isDead ? \"dead\" : \"none\");\n\n    if (action.isDead) {\n      state.deOccupyCell(entity.position.grid);\n      entity.clearShadows();\n    } else {\n      state.occupyCell(entity.position.grid);\n      entity.characteristics.derived.healthPoints.value = entity.characteristics.derived.healthPoints.max;\n      entity.calcShadows(state);\n    }\n\n    return { ...state };\n  }\n\n  return state;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","SetUnitDeadReducerAction"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/editor/unit/setUnitDead.ts","source_lines":"9-30","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"setUnitDead","target_sha256":"7778b77123c6303ade462e9a06b241bec3af53b4bd489ac1cb6b85112280216c","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `setUnitDead` function in the `GameMap` class, which takes a `state` object and an `action` object as parameters. The function should update the `isDead`, `blocksRays`, and `action` properties of the `entit