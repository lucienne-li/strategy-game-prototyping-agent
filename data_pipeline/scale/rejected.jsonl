{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0114","messages":[{"role":"user","content":"Implement the FogOfWar class with the following features:\n\n- A constructor that takes a `size` object as input and initializes the canvas and context.\n\n- A method `render` that takes a `hero` object as input and returns the background color of the fog.\n\n- The `render` method uses the `Offscreen"},{"role":"assistant","content":"export class FogOfWar {\n  private canvas: OffscreenCanvas;\n  private ctx: OffscreenCanvasRenderingContext2D;\n  private bg = \"\";\n\n  private readonly size: Size2D;\n  constructor(props: { size: Size2D }) {\n    this.size = props.size;\n    this.canvas = new OffscreenCanvas(props.size.width, props.size.height);\n    this.ctx = this.canvas.getContext(\"2d\")!;\n  }\n\n  async render(hero: Unit): Promise<FogOfWar[\"bg\"]> {\n    const hideFill = `rgba(0, 0, 0, ${constants.FOG_OF_WAR_OPACITY})`;\n    const { ctx } = this;\n    const { width, height } = this.size;\n\n    ctx.clearRect(0, 0, width, height);\n    ctx.globalCompositeOperation = \"source-over\";\n\n    ctx.fillStyle = hideFill;\n    ctx.lineWidth = 0;\n    ctx.fillRect(0, 0, width, height);\n\n    ctx.globalCompositeOperation = \"destination-out\";\n\n    const { x, y } = hero.position.grid;\n\n    ctx.beginPath();\n    ctx.moveTo(x, y);\n\n    for (const ray of hero.fieldOfView.rays) {\n      ctx.lineTo(\n        Math.round(ray.n.grid.x * ray.len.grid) + ray.position.grid.x,\n        Math.round(ray.n.grid.y * ray.len.grid) + ray.position.grid.y,\n      );\n    }\n\n    ctx.lineTo(x, y);\n    ctx.closePath();\n    ctx.ellipse(x, y, 1, 3, -Math.PI / 4, 0, 2 * Math.PI);\n    ctx.fill();\n\n    //\n    const blob = await this.canvas.convertToBlob();\n\n    this.bg = window.URL.createObjectURL(blob);\n\n    return this.bg;\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["OffscreenCanvas","OffscreenCanvasRenderingContext2D","Size2D","Unit","FOG_OF_W