onst stopTime = turnOnSfx.buffer!.duration * 1000 - 265;\n\n    if (idleSfx) {\n      window.setTimeout(() => {\n        vehicle.currentPlayingSfx[\"idle\"] = idleSfx;\n\n        idleSfx.loop = true;\n        idleSfx.start();\n      }, stopTime);\n    }\n\n    turnOnSfx.start();\n  }\n\n  // vehicle.currentPlayingSfx[]\n  //\n  // state.playSfx([vehicle.dictEntity.sfx[\"turnOn\"].src], 1, 0).then((a) => {\n  //   console.log(a);\n  //   state.playSfx([vehicle.dictEntity.sfx[\"idle\"].src], 1, 0);\n  // });\n\n  return { ...state };\n}\n","review":{"alignment":"pass","granularity_match":"pass","obvious_quality":"pass","decision":"accept","primary_issue":"NONE","notes":"No obvious alignment, granularity or completeness defect found in manual review."}},"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0100","target_jaccard":0.3833,"instruction_nearest":"scale-rjct-react-isometric-game-0100","instruction_jaccard":0.4884},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED"]}}
