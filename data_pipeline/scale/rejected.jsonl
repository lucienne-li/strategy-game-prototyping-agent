{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0375","messages":[{"role":"user","content":"Implement the `upgradeCost` function in TypeScript, following the provided signature and constraints."},{"role":"assistant","content":"export function upgradeCost(\n  t: Tower,\n  path: UpgradePath,\n  ceiling: number = BALANCE.upgrade.maxTier,\n): number | null {\n  // A station with no damage has no damage path. `damageAtTier` multiplies the\n  // def's damage, so on an Overclock every tier of this track is a purchase\n  // that provably cannot move a number the sim reads â€” a money sink, not a\n  // decision. Priced as unavailable rather than left to sell nothing.\n  if (path === 'damage' && !hasDamagePath(t.defId)) return null;\n  const tier = t.tiers[path];\n  // The ceiling defaults to the global maximum, which is what the campaign and\n  // Race always pass. Versus passes `tierCeiling(w)` so the era caps it.\n  if (tier >= ceiling) return null;\n  return Math.round(TOWERS[t.defId].cost * BALANCE.upgrade.costFactor * tier);\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["Tower","UpgradePath","BALANCE","A","Overclock","Priced","The","Race","Versus","TOWERS"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/build.ts","source_lines":"227-242","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"upgradeCost","target_sha256":"47c516940c2748f403f70910ef519413378e31d69c94130a4249a17ea9ea4bb6","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `upgradeCost` function in TypeScript, following the provided signature and constraints.\"\n}\n```","batch_seconds":25.019},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0375","target_sha256":"47c51694