{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0361","messages":[{"role":"user","content":"Implement the `stepWorld` function in TypeScript, following the provided signature and instructions."},{"role":"assistant","content":"export function stepWorld(w: World, dt: number): void {\n  // A finished match freezes rather than continuing to tick. M6 puts a result\n  // screen over the top of it.\n  if (w.phase !== 'playing') return;\n\n  applyCommands(w);\n  updateWaves(w, dt);\n  // Shields recover before anything can shoot at them.\n  updateStatuses(w, dt);\n  moveCreeps(w, dt);\n  // Fire before stepping: a projectile spawned this tick waits a tick before\n  // moving, which is one frame of muzzle position rather than a shot that\n  // teleports partway to its target the instant it appears.\n  fireTowers(w, dt);\n  stepProjectiles(w, dt);\n  // After every system that iterates `w.creeps`, before the sweep that would\n  // otherwise drop the parents the children are positioned from.\n  resolveSplits(w);\n  cleanup(w);\n\n  // Checked after cleanup so the leak that emptied the life bar has already\n  // been counted, and once only â€” the phase change stops the next tick.\n  if (w.lives <= 0) {\n    w.phase = 'lost';\n    w.events.push({ type: 'gameOver', won: false });\n  }\n\n  w.time += dt;\n  w.tick++;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","A","M6","Shields","Fire","After","Checked"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/step.ts","source_lines":"22-51","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"stepWorld","target_sha256":"d991739b2167befe68017f9e315945814540eb230146cd189e28abee34674a16","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `stepWorld` function in TypeScript, following the provided signature and instructions.\"\n}\n```","batch_seconds":26.285},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0361","target_sha256":"d991739b2167befe68017f9e315945814540eb230146cd189e28abee34674a16","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":23.286},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0094","target_jaccard":0.0896,"instruction_nearest":"scale-rjct-react-isometric-game-0095","instruction_jaccard":0.1622},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0362","messages":[{"role":"user","content":"Create a TypeScript function `renderInspector` that takes a `World` and a `Tower` as input and returns a string representing the inspector's UI."},{"role":"assistant","content":"export function renderInspector(w: World, t: Tower): string {\n  const d = TOWERS[t.defId];\n  const s = t.stats;\n  const nextDamage = nextStats(t, 'damage', tierCeiling(w))?.damage ?? null;\n\n  // Iconic, with **the active mode labelled** â€” not labels-on-hover.\n  //\n  // Four unlabelled glyphs would be unguessable (Strong and Close especially),\n  // `title` never fires on touch, and this control mutates game state so a\n  // mis-click has a cost. Naming only the selected one costs exactly one word,\n  // is self-teaching â€” the player sees \"First\" beside its glyph and learns the\n  // glyph â€” and works without a pointer. `aria-label` on all four regardless.\n  const modes = TARGET_MODES.map((m) => {\n    const on = t.targeting === m;\n    return (\n      `<button data-act=\"target\" data-mode=\"${m}\" class=\"${on ? 'on' : ''}\"` +\n      // No `title`: it duplicates the aria-label, and the active mode is\n      // already spelled out beside its glyph â€” which is the affordance that\n      // works without a pointer.\n      ` aria-label=\"${TARGET_LABEL[m]}\">${TARGET_GLYPH[m]}` +\n      (on ? `<span>${TARGET_LABEL[m]}</span>` : '') +\n      `</button>`\n    );\n  }).join('');\n\n  return (\n    `<div class=\"inspector\">` +\n    // Portrait column: the station wearing its real collar at full size, so the\n    // board's positional upgrade code is taught here rather than by a 13px\n    // afterthought on a button. The board only has to jog this memory.\n    `<div class=\"portrait t-${t.defId}\">${stationIcon(t.defId, 40)}` +\n    `${collarDial(t.tiers, BALANCE.upgrade.maxTier, 56)}` +\n    `<span class=\"mk\">Mk ${'I'.repeat(visualTier(t))}</span></div>` +\n    `<div class=\"body\">` +\n    `<div class=\"head t-${t.defId}\"><b>${d.name}</b>` +\n    // Tile coordinates dropped â€” the one fact here nobody has ever needed.\n    // Damage dealt stays in the `title` rather than becoming text: this is the\n    // inspector, read mid-wave, and it is held to a hard ten-word budget that\n    // tools/check.ts enforces. The words go to the armed panel instead.\n    `<span class=\"blurb\" title=\"${Math.round(t.damageDealt)} damage dealt\">` +\n    `${t.kills} ${t.kills === 1 ? 'kill' : 'kills'}</span></div>` +\n    // Live stats, not the def: this is where an effect purchase becomes visible\n    // in numbers, including the secondary dial the upgrade card omits. One row\n    // for both chip groups â€” the inspector's height budget has no room for two.\n    `<div class=\"chipline t-${t.defId}\">${mechanicChips(s)}${axisChips(s, false, effectiveInterval(t))}</div>` +\n    renderArmourLine(w, t, nextDamage) +\n    `</div>` +\n    `<div class=\"upgrades\">${renderPathButtons(w, t)}</div>` +\n    `<div class=\"actions\"><div class=\"seg targeting\">${modes}</div>` +\n    `<button class=\"btn\" data-act=\"sell\">Sell ${sellValue(t)}</button></div>` +\n    `</div>`\n  );\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","Tower","TOWERS","Iconic","Four","Strong","Close","Naming","First","TARGET_MODES","No","TARGET_LABEL"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/ui/hud.ts","source_lines":"846-898","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"renderInspector","target_sha256":"c3fd0f5a92e636cc0bcb87a6d64bc51c0dabd69d4b0325696399d9c2369ed279","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Create a TypeScript function `renderInspector` th