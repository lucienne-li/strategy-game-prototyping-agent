{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0234","messages":[{"role":"user","content":"Implement the `describeAccion` function in TypeScript, following the provided signature and potential provided symbols. The function should handle different types of actions such as `move`, `attack`, `shoot`, `wait`, `defend`, `cast`, `move_hero`, `hire_hero`, `recruit`, `build`, and `end_turn`. The function"},{"role":"assistant","content":"export function describeAccion(accion: BattleAction | AdventureAction): string {\n  switch (accion.type) {\n    case 'move':\n      return `movimiento a (${accion.to.col},${accion.to.row})`;\n    case 'attack':\n      return `ataque a ${accion.target}`;\n    case 'shoot':\n      return `disparo a ${accion.target}`;\n    case 'wait':\n      return 'espera';\n    case 'defend':\n      return 'defensa';\n    case 'cast':\n      return `hechizo ${accion.spell}${accion.target === undefined ? '' : ` sobre ${accion.target}`}`;\n    case 'move_hero':\n      return `move_hero ${accion.hero} â†’ (${accion.to.x},${accion.to.y})`;\n    case 'hire_hero':\n      return `hire_hero en ${accion.town}`;\n    case 'recruit':\n      return `recruit ${accion.count}Ã— ${accion.creature} en ${accion.town}`;\n    case 'build':\n      return `build ${accion.building} en ${accion.town}`;\n    case 'end_turn':\n      return 'end_turn';\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["BattleAction","AdventureAction"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/server/notas.ts","source_lines":"557-582","repository_family_id":"github-family:alberto-hortelano/heroes-of-silence","license":"MIT","category":"tactics","granularity":"G1","symbol":"describeAccion","target_sha256":"144ff4c871dc1eada50722dc532868d74ac28519b6f3acbb7701d7bd184c7053","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instructi