{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0125","messages":[{"role":"user","content":"Implement the `Building` class in TypeScript, following the provided guidelines."},{"role":"assistant","content":"export class Building extends GameEntity {\n  public readonly dictEntity: BuildingDictEntity;\n  public readonly class;\n  public readonly type: BuildingType;\n\n  public readonly className;\n  public readonly variants;\n  variant = 0;\n\n  constructor(props: {\n    gameState: GameMap;\n    buildingType: BuildingType;\n    position: GridCoordinates;\n    rotation: AngleInDegrees;\n    variant: number;\n    occupiesCell: boolean;\n  }) {\n    const dictEntity: BuildingDictEntity = { ...getBuildingsDictList()[props.buildingType] };\n\n    super({\n      gameState: props.gameState,\n      dictEntity,\n      position: props.position,\n      rotation: props.rotation,\n      internalColor: dictEntity.internalColor,\n      occupiesCell: dictEntity.occupiesCell,\n      blocksRays: dictEntity.blocksRays,\n      lootable: dictEntity.lootable,\n    });\n\n    this.dictEntity = dictEntity;\n\n    this.class = dictEntity.class;\n    this.type = props.buildingType;\n    this.className = [\"building\", this.dictEntity.className].join(\" \");\n\n    this.variants = this.dictEntity.variants;\n    this.variant = props.variant;\n\n    this.occupiesCell = props.occupiesCell;\n  }\n\n  public setRotation(angle: Angle) {\n    super.setRotation(angle);\n\n    this.size = {\n      grid: calculateSizeAfterRotation(this.dictEntity.size.grid, this.rotation),\n      screen: { ...this.size.screen },\n    };\n\n    this.createWalls();\n  }\n\n  public setVariant(variant: number) {\n    this.variant = variant;\n  }\n\n  public getAvailableRotationAngles() {\n    return [...this.dictEntity.rotationAngles];\n  }\n\n  public putItemToInventory(item: Weapon | Ammo) {\n    this.inventory.main.push(item);\n  }\n\n  public getInventoryItemById(itemId: string) {\n    return this.getInventoryItems().find((item) => item?.id === itemId);\n  }\n\n  public getClipPath() {\n    return this.dictEntity.clipPath?.[this.variant]?.[`${this.rotation.deg}deg`]?.cssClipPath;\n  }\n\n  public getJSON() {\n    const json = {\n      type: this.type,\n      position: this.getRoundedPosition(),\n      rotation: this.rotation.deg,\n      variant: this.variant,\n    } as StaticMapBuilding;\n\n    if (!this.occupiesCell) {\n      json.occupiesCell = false;\n    }\n\n    if (this.inventory?.main.length > 0) {\n      json.inventory = {\n        main: super.getInventoryMainJSON(),\n      };\n    }\n\n    return json;\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameEntity","BuildingDictEntity","BuildingType","GameMap","GridCoordinates","AngleInDegrees","Angle","Weapon","Ammo","StaticMapBuilding"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/engine/building/BuildingFactory.ts","source_lines":"10-103","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G2","symbol":"Building","target_sha256":"f77122233b1c927304c40df170438f58db630e272888020c38f65a1d87777707","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `Building` class in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":21.451},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0125","target_sha256":"f77122233b1c927304c40df170438f58db630e272888020c38f65a1d87777707","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":63.449},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-