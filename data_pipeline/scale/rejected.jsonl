{"schema_version":"1.0","sample_id":"scale-djpav-threejs-tower-defense-0411","messages":[{"role":"user","content":"Implement the `GameStateManager` class with the following features:\n\n- **State Management**: Use an object to store the current state of the game, including gold, lives, wave number, and level.\n\n- **Observable Inputs**: Implement methods to handle enemy kills, reach goals, and wave completions.\n\n- **Observable Outputs**:"},{"role":"assistant","content":"export class GameStateManager {\n  private state: GameState;\n  private eventBus: EventBus;\n  private handleEnemyKilled: (data: { reward: number }) => void;\n  private handleEnemyReachedGoal: (data: { damage: number }) => void;\n  private handleWaveComplete: (data: { wave: number }) => void;\n\n  constructor(eventBus: EventBus, totalWaves: number, options: GameStateOptions = {}) {\n    this.eventBus = eventBus;\n    this.state = {\n      gold: options.startingGold ?? STARTING_GOLD,\n      lives: options.startingLives ?? STARTING_LIVES,\n      wave: 0,\n      totalWaves,\n      level: options.level ?? 1,\n      levelName: options.levelName ?? \"\",\n      isGameOver: false,\n      isWin: false,\n    };\n\n    this.handleEnemyKilled = ({ reward }) => {\n      this.addGold(reward);\n    };\n\n    this.handleEnemyReachedGoal = ({ damage }) => {\n      this.loseLives(damage);\n    };\n\n    this.handleWaveComplete = ({ wave }) => {\n      this.state.wave = wave;\n      if (wave >= totalWaves) {\n        this.state.isWin = true;\n        this.state.isGameOver = true;\n        this.eventBus.emit(\"game-over\", { win: true });\n      }\n    };\n\n    this.eventBus.on(\"enemy-killed\", this.handleEnemyKilled);\n    this.eventBus.on(\"enemy-reached-goal\", this.handleEnemyReachedGoal);\n    this.eventBus.on(\"wave-complete\", this.handleWaveComplete);\n  }\n\n  getState(): Readonly<GameState> {\n    return this.state;\n  }\n\n  get gold(): number {\n    return this.state.gold;\n  }\n\n  get lives(): number {\n    return this.state.lives;\n  }\n\n  canAfford(cost: number): boolean {\n    return this.state.gold >= cost;\n  }\n\n  spendGold(amount: number): boolean {\n    if (!this.canAfford(amount)) return false;\n    this.state.gold -= amount;\n    this.eventBus.emit(\"gold-changed\", { gold: this.state.gold });\n    return true;\n  }\n\n  addGold(amount: number): void {\n    this.state.gold += amount;\n    this.eventBus.emit(\"gold-changed\", { gold: this.state.gold });\n  }\n\n  private loseLives(amount: number): void {\n    if (this.state.isGameOver) return;\n    this.state.lives -= amount;\n    this.eventBus.emit(\"lives-changed\", { lives: this.state.lives });\n\n    if (this.state.lives <= 0) {\n      this.state.lives = 0;\n      this.state.isGameOver = true;\n      this.state.isWin = false;\n      this.eventBus.emit(\"game-over\", { win: false });\n    }\n  }\n\n  dispose(): void {\n    this.eventBus.off(\"enemy-killed\", this.handleEnemyKilled);\n    this.eventBus.off(\"enemy-reached-goal\", this.handleEnemyReachedGoal);\n    this.eventBus.off(\"wave-complete\", this.handleWaveComplete);\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameState","EventBus","GameStateOptions","STARTING_GOLD","STARTING_LIVES","Readonly"]},"metadata":{"source_repo":"djpav/threejs-tower-defense","source_commit":"dcb33e163c96e03d464d868b5b91ca5af93fe4f2","source_path":"src/systems/GameStateManager.ts","source_lines":"12-100","repository_family_id":"github-family:djpav/threejs-tower-defense","license":"MIT","category":"tower-defense","granularity":"G2","symbol":"GameStateManager","target_sha256":"76c828121120b7259e86ceece7b7749403ff2a8a95fff67203d259c3c624b3a3","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `GameStateManager` class with the following features:\\n\\n- **State Management**: Use an object to store the current state of the game, including gold, lives, wave number, and level.\\n\\n- **Observable Inputs**: Implement methods to handle enemy kills, reach goals, and wave completions.\\n\\n- **Observable Outputs**:","batch_seconds":25.778},"independent_review":{"unit_id":"scale-djpav-threejs-tower-defense-0411","target_sha256":"76c828121120b7259e86ceece7b7749403ff2a8a95fff67203d259c3c624b3a3","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":61.113},"stratified_audit":{"audit_version":"1.0","sample_id":"scale-djpav-threejs-tower-defense-0411","category":"tower-defense","granularity":"G2","repository_family_id":"github-family:djpav/threejs-tower-defense","source_repo":"djpav/threejs-tower-defense","source_path":"src/systems/GameStateManager.ts","instruction":"Implement the `GameStateManager` class with the following features:\n\n- **State Management**: Use an object to store the current state of the game, including gold, lives, wave number, and level.\n\n- **Observable Inputs**: Implement methods to handle enemy kills, reach goals, and wave completions.\n\n- **Observable Outputs**:","code":"export class GameStateManager {\n  private state: GameState;\n  private eventBus: EventBus;\n  private handleEnemyKilled: (data: { reward: number }) => void;\n  private handleEnemyReachedGoal: (data: { damage: number }) => void;\n  private handleWaveComplete: (data: { wave: number }) => void;\n\n  constructor(eventBus: EventBus, totalWaves: number, options: GameStateOptions = {}) {\n    this.eventBus = eventBus;\n    this.state = {\n      gold: options.startingGold ?? STARTING_GOLD,\n      lives: options.startingLives ?? STARTING_LIVES,\n      wave: 0,\n      totalWaves,\n      level: options.level ?? 1,\n      levelName: options.levelName ?? \"\",\n      isGameOver: false,\n      isWin: false,\n    };\n\n    this.handleEnemyKilled = ({ reward }) => {\n      this.addGold(reward);\n    };\n\n    this.handleEnemyReachedGoal = ({ damage }) => {\n      this.loseLives(damage);\n    };\n\n    this.handleWaveComplete = ({ wave }) => {\n      this.state.wave = wave;\n      if (wave >= totalWaves) {\n        this.state.isWin = true;\n        this.state.isGameOver = true;\n        this.eventBus.emit(\"game-over\", { win: true });\n      }\n    };\n\n    this.eventBus.on(\"enemy-killed\", this.handleEnemyKilled);\n    this.eventBus.on(\"enemy-reached-goal\", this.handleEnemyReachedGoal);\n    this.eventBus.on(\"wave-complete\", this.handleWaveComplete);\n  }\n\n  getState(): Readonly<GameState> {\n    return this.state;\n  }\n\n  get gold(): number {\n    return this.state.gold;\n  }\n\n  get lives(): number {\n    return this.state.lives;\n  }\n\n  canAfford(cost: number): boolean {\n    return this.state.gold >= cost;\n  }\n\n  spendGold(amount: number): boolean {\n    if (!this.canAfford(amount)) return false;\n    this.state.gold -= amount;\n    this.eventBus.emit(\"gold-changed\", { gold: this.state.gold });\n    return true;\n  }\n\n  addGold(amount: number): void {\n    this.state.gold += amount;\n    this.eventBus.emit(\"gold-changed\", { gold: this.state.gold });\n  }\n\n  private loseLives(amount: number): void {\n    if (this.state.isGameOver) return;\n    this.state.lives -= amount;\n    this.eventBus.emit(\"lives-changed\", { lives: this.state.lives });\n\n    if (this.state.lives <= 0) {\n      this.state.lives = 0;\n      this.state.isGameOver = true;\n      this.state.isWin = false;\n      this.eventBus.emit(\"game-over\", { win: false });\n    }\n  }\n\n  dispose(): void {\n    this.eventBus.off(\"enemy-killed\", this.handleEnemyKilled);\n    this.eventBus.off(\"enemy-reached-goal\", this.handleEnemyReachedGoal);\n    this.eventBus.off(\"wave-complete\", this.handleWaveComplete);\n  }\n}\n","review":{"alignment":"not_assessable","granularity_match":"not_assessable","obvious_quality":"fail","decision":"reject","primary_issue":"TRUNCATED","notes":"Instruction ends mid-sentence or mid-lis