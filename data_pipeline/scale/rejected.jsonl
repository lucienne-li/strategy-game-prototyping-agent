{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0397","messages":[{"role":"user","content":"Create a TypeScript game with a tower defense theme, including a legend of towers and contacts. The game should have a main menu with options for building stations and contacts, as well as a leaderboard displaying the top players. The game should also include a feature to build towers and contacts, and a feature to stop them. The game should have a scoring system that"},{"role":"assistant","content":"export function legendHtml(): string {\n  const stations = TOWER_IDS.map(\n    (id) =>\n      `<li><span class=\"lg-ic t-${id}\">${stationIcon(id, 34)}</span>` +\n      `<span><b>${TOWERS[id].name}</b>${TOWERS[id].unlockWave > 0 ? ` <em>wave ${TOWERS[id].unlockWave + 1}</em>` : ''}` +\n      `<span>${describeStation(id)}</span></span></li>`,\n  ).join('');\n\n  const contacts = ENEMY_IDS.map(\n    (id) =>\n      `<li><span class=\"lg-ic\">${contactIcon(id, 30)}</span>` +\n      `<span><b>${ENEMIES[id].name}</b><span>${describeContact(ENEMIES[id])}</span></span></li>`,\n  ).join('');\n\n  return (\n    `<h2>How to play</h2>` +\n    `<p class=\"lg-lede\">Contacts walk the road toward your core. Build stations beside it and ` +\n    `stop them. A contact that reaches the core costs a life.</p>` +\n    `<h3>Stations</h3><ul class=\"lg-list\">${stations}</ul>` +\n    `<h3>Contacts</h3><ul class=\"lg-list\">${contacts}</ul>`\n  );\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["TOWER_IDS","TOWERS","ENEMY_IDS","ENEMIES","How","Contacts","Build","A","Stations"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/ui/legend.ts","source_lines":"55-76","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"legendHtml","target_sha256":"e148249bc6112417a463e2fa60585872b7aa428abe7223a0539f10c6c5f42d6d","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Create a TypeScript game with a tower defense theme, including a legend of towers and contacts. The game should have a main menu with options for building stations and contacts, as well as a leaderboard displaying the top players. The game should also include a feature to build towers and contacts, and a feature to stop them. The game should have a scoring system that","batch_seconds":19.242},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0397","target_sha256":"e148249bc6112417a463e2fa60585872b7aa428abe7223a0539f10c6c5f42d6d","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":79.734},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-cbhead-deep-field-td-0371","target_jaccard":0.1402,"instruction_nearest":"scale-cbhead-deep-field-td-0369","instruction_jaccard":0.1864},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED","SYMBOL_NOT_NAMED"]}}
{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0400","messages":[{"role":"user","content":"Implement the `renderSlots` function in TypeScript, following the provided signature and instructions."},{"role":"assistant","content":"export function renderSlots(w: World, ui: UiState): string {\n  return TOWER_IDS.map((id) => {\n    const def = TOWERS[id];\n\n    // Locked says one thing: when. No cost, no shortfall, nothing to weigh â€”\n    // it is not a decision yet.\n    //\n    // Under eras \"when\" is a *purchase* rather than a moment, so the slot names\n    // the rung instead of the wave. Both are the same sentence â€” this is what\n    // you do not have yet, and here is the thing that will give it to you.\n    if (!isUnlocked(w, id)) {\n      const gate = w.rules.eras ? `Era ${ROMAN[def.era] ?? def.era}` : `Wave ${def.unlockWave + 1}`;\n      return (\n        `<div class=\"slot locked\" aria-label=\"${def.name}, unlocks at ${gate}\">` +\n        `${stationIcon(id, 40)}<span class=\"wave\">${gate}</span></div>`\n      );\n    }\n\n    const short = def.cost - w.money;\n    const poor = short > 0;\n    const cls = ['slot', `t-${id}`, ui.selected === id ? 'armed' : '', poor ? 'poor' : '']\n      .filter(Boolean)\n      .join(' ');\n\n    return (\n      `<button class=\"${cls}\" data-act=\"arm\" data-id=\"${id}\" title=\"${def.blurb}\">` +\n      `<kbd>${def.hotkey}</kbd>` +\n      `<span class=\"corner\">${def.cost}</span>` +\n      stationIcon(id, 40) +\n      // Naming the gap turns \"no\" into \"not yet, and by this much\" â€” which is\n      // the difference between a dead control and a plan.\n      (poor ? `<span class=\"short\">short ${short}</span>` : '') +\n      `<span class=\"name\">${def.name}</span></button>`\n    );\n  }).join('');\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","UiState","TOWER_IDS","TOWERS","Locked","No","Under","Both","Era","ROMAN","Wave","Boolean"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/ui/hud.ts","source_lines":"634-669","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"renderSlots","target_sha256":"618d75c3f0be885a818b5155b001fd5c508711bfc01911b6a9e00c17e402114c","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `renderSlots` function in TypeScript, following the provided signature and instructions.\"\n}\n```","batch_seconds":19.242},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0400","target_sha256":"618d75c3f0be885a818b5155b001fd5c508711bfc01911b6a9e00c17e402114c","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":79.734},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-cbhead-deep-field-td-0379","target_jaccard":0.2386,"instruction_nearest":"scale-cbhead-deep-field-td-0393","instruction_jaccard":0.2941},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
