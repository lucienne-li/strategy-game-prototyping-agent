{"schema_version":"1.0","sample_id":"scale-noiron-tower-defense-js-0305","messages":[{"role":"user","content":"Create a TypeScript class `BulletTower` that extends `BaseTower`. The class should have the following properties and methods:\n\n- `type`: A string representing the type of the tower ('BULLET')\n- `hue`: An integer representing the hue of the tower's color\n- `cost`: An integer representing the cost of the tower"},{"role":"assistant","content":"export default class BulletTower extends BaseTower {\n  constructor(opt: any) {\n    super(opt);\n\n    this.type = 'BULLET';\n    this.hue = 200;\n    this.cost = towerData[this.type].cost;\n    this.range = 3 * gridWidth;\n\n    this.direction = opt.direction || 0; // ç”¨åº¦æ•°è¡¨ç¤ºçš„toweræŒ‡å‘\n  }\n\n  draw() {\n    const ctx = this.ctx;\n\n    // å°†æ–¹å‘å‘é‡å½’ä¸€åŒ–\n    this.directionVec = vec2.fromValues(\n      Math.cos(toRadians(this.direction)),\n      Math.sin(toRadians(this.direction))\n    );\n    vec2.normalize(this.directionVec, this.directionVec);\n\n    // bullet å‡ºå°„ä½ç½®\n    vec2.scale(this.bulletStartPosVec, this.directionVec, 30);\n\n    ctx.save();\n    if (config.renderShadow) {\n      ctx.shadowBlur = this.radius;\n      ctx.shadowColor = 'hsl(' + this.hue + ',100%,60%)';\n    }\n\n    // åœ¨é€‰ä¸­çš„æƒ…å†µä¸‹ï¼Œç”»å‡ºå…¶å°„ç¨‹èŒƒå›´\n    if (this.selected) {\n      ctx.beginPath();\n      ctx.fillStyle = 'rgba(200, 200, 200, 0.3)';\n      ctx.arc(this.x, this.y, this.range, 0, 2 * Math.PI);\n      ctx.fill();\n    }\n\n    ctx.strokeStyle = 'hsl(' + this.hue + ',100%,80%';\n    ctx.fillStyle = 'hsl(' + this.hue + ',100%,80%';\n    ctx.lineWidth = Math.max(3, this.radius / 8);\n\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.radius, 0, 2 * Math.PI);\n    ctx.closePath();\n    ctx.stroke();\n    ctx.fill();\n\n    ctx.beginPath();\n    ctx.moveTo(this.x, this.y);\n    ctx.lineTo(\n      this.x + this.bulletStartPosVec[0],\n      this.y + this.bulletStartPosVec[1]\n    );\n    ctx.stroke();\n    ctx.closePath();\n\n    if (\n      this.targetIndex !== -1 &&\n      new Date().getTime() - this.lastShootTime.getTime() >= 500\n    ) {\n      this.shoot();\n      this.lastShootTime = new Date();\n    }\n\n    ctx.restore();\n  }\n\n  // å‘å°„å­å¼¹\n  shoot() {\n    this.bullets.push(\n      new CircleBullet({\n        id: globalId.genId(),\n        target: this.target,\n        ctx: this.ctx,\n        x: this.x + this.bulletStartPosVec[0],\n        y: this.y + this.bulletStartPosVec[1],\n        range: this.range,\n        damage: this.damage,\n        parent: this,\n      })\n    );\n  }\n\n  findTarget(enemies: EntityCollection<Enemy>) {\n    return super.findTarget(enemies);\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["BaseTower","BULLET","PI","Date","CircleBullet","EntityCollection","Enemy"]},"metadata":{"source_repo":"noiron/tower-defense-js","source_commit":"b70ccbbb618a46b796d2a89ea92c4e1e4c28b0c0","source_path":"src/entities/towers/BulletTower.ts","source_lines":"11-99","repository_family_id":"github-family:noiron/tower-defense-js","license":"MIT","category":"tower-defense","granularity":"G2","symbol":"BulletTower","target_sha256":"b051212c2c89b2b95160d8dabbf2061b312513a06df188305af4592dd7c0c410","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Create a TypeScript class `BulletTower` that extends `BaseTower`. The class should have the following properties and methods:\\n\\n- `type`: A string representing the type of the tower ('BULLET')\\n- `hue`: An integer representing the hue of the tower's color\\n- `cost`: An integer representing the cost of the tower","batch_seconds":23.893},"independent_review":{"unit_id":"scale-noiron-tower-defense-js-0305","target_sha256":"b051212c2c89b2b95160d8dabbf2061b312513a06df188305af4592dd7c0c410","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PA