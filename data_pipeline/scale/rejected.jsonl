{"schema_version":"1.0","sample_id":"scale-emp3thy-nuclearwar-0185","messages":[{"role":"user","content":"Implement the `bestTargetByLookahead` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"export function bestTargetByLookahead(\n  state: GameState,\n  viewer: LeaderId,\n  baseline: Order[],\n  candidates: readonly LeaderId[],\n  launch: LookaheadLaunchSpec,\n  opponentPlanner: (state: GameState, leaderId: LeaderId) => Order[],\n): LeaderId | null {\n  if (candidates.length === 0) return null;\n\n  let best: LeaderId | null = null;\n  let bestScore = -Infinity;\n\n  for (const target of candidates) {\n    const selfOrders: Order[] = [\n      ...baseline,\n      { kind: 'launch', target, ...launch },\n    ];\n    const ordersByLeader: Partial<Record<LeaderId, Order[]>> = {\n      [viewer]: selfOrders,\n    };\n    for (const id of state.cast) {\n      if (id === viewer) continue;\n      const opp = state.leaders[id];\n      if (!opp || !opp.alive) continue;\n      if (isHuman(id)) {\n        // Project the human by their most recent non-empty round within a\n        // sliding window (Approach B â€” see recentHumanOrders). A recent pass no\n        // longer reads as passivity. simulateOneRound re-validates and drops\n        // orders the human can no longer afford (e.g. a launch from an earlier\n        // round when their stockpile is now empty).\n        ordersByLeader[id] = recentHumanOrders(state.orderHistory, id);\n        continue;\n      }\n      ordersByLeader[id] = opponentPlanner(state, id);\n    }\n    const projected = simulateOneRound(state, ordersByLeader);\n    const score = scoreState(projected, viewer);\n    if (score > bestScore) {\n      bestScore = score;\n      best = target;\n    }\n  }\n\n  return best;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameState","LeaderId","Order","LookaheadLaunchSpec","Infinity","Partial","Record","Project","Approach","B","A"]},"metadata":{"source_repo":"emp3thy/nuclearwar","source_commit":"bf38ff3b07d65b6a4ddb1206c3a75a5d291f695b","source_path":"src/engine/ai/lookahead.ts","source_lines":"103-148","repository_family_id":"github-family:emp3thy/nuclearwar","license":"MIT","category":"tactics","granularity":"G1","symbol":"bestTargetByLookahead","target_sha256":"30ba30d4ccd689ed13b4ff31e5ce6bc3f310fc2685c4427ad517edae4a33c73e","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `bestTargetByLookahead` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":27.243},"independent_review":{"unit_id":"scale-emp3thy-nuclearwar-0185","target_sha256":"30ba30d4ccd689ed13b4ff31e5ce6bc3f310fc2685c4427ad517edae4a33c73e","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":64.278},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-cbhead-deep-field-td-0380","target_jaccard":0.2206,"instruction_nearest":"scale-cbhead-deep-field-td-0393","instruction_jaccard":0.3333},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-emp3thy-nuclearwar-0186","messages":[{"role":"user","content":"Implement the `respondToAttackers` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"function respondToAttackers(\n  state: GameState,\n  id: LeaderId,\n  tryAdd: Adder,\n  maxRetal: number,\n): boolean {\n  const me = state.leaders[id];\n  const others = aliveOthers(state, id);\n  const attackers = others\n    .filter((t) => (me.grudge[t] ?? 0) > 0)\n    .sort((a, b) => (me.grudge[b] ?? 0) - (me.grudge[a] ?? 0));\n  if (attackers.length === 0) return false;\n\n  // Defend first: deploy whatever interceptors are in stock.\n  tryAdd({ kind: 'deploy-defence', type: 'shield' });\n  tryAdd({ kind: 'deploy-defence', type: 'aa' });\n\n  const primary = attackers[0];\n  const atk = state.leaders[primary];\n  // \"Reasonable attack\": worth chasing elimination if the attacker is\n  // finishable or not far stronger than us. Otherwise a single warning shot.\n  const reasonable = atk.population <= 12 || atk.population <= me.population * 1.5;\n  const toFinish = Math.ceil(atk.population / 2); // small warhead â‰ˆ 2 pop damage\n  const want = reasonable ? Math.min(toFinish, maxRetal) : 1;\n\n  let fired = 0;\n  let guard = 0;\n  while (fired < want && guard < 12) {\n    guard++;\n    const launch: Order = {\n      kind: 'launch', target: primary, delivery: 'missile', warhead: 'small', targetType: 'people',\n    };\n    if (tryAdd(launch)) {\n      fired++;\n      continue;\n    }\n    // Out of ammo â€” build a missile + warhead, then try again next iteration.\n    const b1 = tryAdd({ kind: 'build-missile' });\n    const b2 = tryAdd({ kind: 'build-warhead', yield: 'small' });\n    if (!b1 && !b2) break; // no AP left to arm\n  }\n  return true;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameState","LeaderId","Adder","Defend","Reasonable","Otherwise","Order","Out","AP"]},"metadata":{"source_repo":"emp3thy/nuclearwar","source_commit":"bf38ff3b07d65b6a4ddb1206c3a75a5d291f695b","source_path":"scripts/playability/humanPolicy.ts","source_lines":"33-75","repository_family_id":"github-family:emp3thy/nuclearwar","license":"MIT","category":"tactics","granularity":"G1","symbol":"respondToAttackers","target_sha256":"d2b011b69bffe2f6a8b3a507a28282603b6f1b06264a2d01c705a7e305993f2c","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `respondToAttackers` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":27.243},"independent_review":{"unit_id":"scale-emp3thy-nuclearwar-0186","target_sha256":"d2b011b69bffe2f6a8b3a507a28282603b6f1b06264a2d01c705a7e305993f2c","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":64.278},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-emp3thy-nuclearwar-0181","target_jaccard":0.5119,"instruction_nearest":"scale-cbhead-deep-field-td-0393","instruction_jaccard":0.3333},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
