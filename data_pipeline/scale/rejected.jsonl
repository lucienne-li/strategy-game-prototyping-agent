{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0115","messages":[{"role":"user","content":"Implement the `LightRay` class with the following features:\n\n- A `position` object containing `grid` and `screen` coordinates.\n\n- A `len` object containing `grid` and `screen` dimensions.\n\n- A `n` object containing `grid` and `screen` normalized coordinates.\n\n- A"},{"role":"assistant","content":"export class LightRay {\n  position: {\n    grid: GridCoordinates;\n    screen: ScreenCoordinates;\n  } = {\n    grid: { x: 0, y: 0 },\n    screen: { x: 0, y: 0 },\n  };\n  len = {\n    grid: 0,\n    screen: 0,\n  };\n  n: {\n    grid: { x: number; y: number };\n    screen: { x: number; y: number };\n  } = {\n    grid: { x: 0, y: 0 },\n    screen: { x: 0, y: 0 },\n  };\n\n  color = \"\";\n  angle: AngleInRadians = 0;\n  collidedWithEntity: Building | Unit | Vehicle | null = null;\n\n  constructor(props: { position: GridCoordinates; radius: number; color: string }) {\n    this.setPosition(props.position);\n    this.setLen(props.radius);\n    this.setColor(props.color);\n    this.setRotation(0);\n  }\n\n  setRotation(angle: AngleInRadians) {\n    this.angle = angle;\n\n    this.n = {\n      grid: { x: Math.cos(angle), y: Math.sin(angle) },\n      screen: { x: Math.cos(angle), y: Math.sin(angle) },\n    };\n  }\n\n  setPosition(position: GridCoordinates) {\n    this.position = {\n      grid: {\n        x: position.x + 0.5,\n        y: position.y + 0.5,\n      },\n      screen: {\n        x: (position.x + 0.5) * constants.wireframeTileSize.width,\n        y: (position.y + 0.5) * constants.wireframeTileSize.height,\n      },\n    };\n  }\n\n  setLen(len: number) {\n    this.len = {\n      grid: len,\n      screen: len * constants.wireframeTileSize.width,\n    };\n  }\n\n  setColor(color: string) {\n    this.color = color;\n  }\n\n  cast(entities: Array<Building | Unit | Vehicle>) {\n    let minDist = this.len.grid;\n    let collidedWithEntity = null;\n    this.collidedWithEntity = null;\n\n    for (const entity of entities) {\n      if (!entity.blocksRays) continue;\n\n      const d = entity.rayDist2Polygon(this);\n\n      if (d.distance < minDist) {\n        minDist = d.distance;\n        collidedWithEntity = d.entity;\n      }\n    }\n\n    this.len = {\n      grid: minDist,\n      screen: minDist * constants.wireframeTileSize.width,\n    };\n    this.collidedWithEntity = collidedWithEntity;\n\n    return collidedWithEntity;\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GridCoordinates","ScreenCoordinates","AngleInRadians","Building","Unit","Vehicle"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/engine/light/LightRayFactory.ts","source_lines":"6-94","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G2","symbol":"LightRay","target_sha256":"305915ac83f872346f95b7d7d9f3543b72fc353b61d3063110b8a4d8ee6884f3","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `LightRay` class with the following features:\\n\\n- A `position` object containing `grid` and `screen` coordinates.\\n\\n- A `len` object containing `grid` and `screen` dimensions.\\n\\n- A `n` object containing `grid` and `screen` normalized coordinates.\\n\\n- A","batch_seconds":24.09},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0115","target_sha256":"305915ac83f872346f95b7d7d9f3543b72fc353b61d3063110b8a4d8ee6884f3","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":20.418},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game