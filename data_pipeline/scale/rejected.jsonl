{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0110","messages":[{"role":"user","content":"Implement the `pathFinderAStar` function in TypeScript, following the provided signature and constraints."},{"role":"assistant","content":"export function pathFinderAStar(\n  matrix: GameMap[\"matrix\"],\n  fromPos: GridCoordinates,\n  toPos: GridCoordinates,\n  diagonalMovement: pathfinding.DiagonalMovement = pathfinding.DiagonalMovement.Never,\n) {\n  const grid = new pathfinding.Grid(matrix);\n  const finder = new pathfinding.AStarFinder({\n    diagonalMovement: diagonalMovement,\n    heuristic: pathfinding.Heuristic.euclidean,\n  });\n\n  return finder.findPath(Math.round(fromPos.x), Math.round(fromPos.y), Math.round(toPos.x), Math.round(toPos.y), grid);\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","GridCoordinates","DiagonalMovement","Never","Grid","AStarFinder","Heuristic"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/engine/unit/pathFinder.ts","source_lines":"4-17","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"pathFinderAStar","target_sha256":"f811f2c678b3ca18a2fd8fe43933701f53032df6270d79c68a75de24f762e6a0","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `pathFinderAStar` function in TypeScript, following the provided signature and constraints.\"\n}\n```","batch_seconds":24.09},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0110","target_sha256":"f811f2c678b3ca18a2fd8fe43933701f53032df6270d79c68a75de24f762e6a0","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":20.418},"stratified_audit":null,"quality":{"method":"deterministic_contra