{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0112","messages":[{"role":"user","content":"Implement the `recalculateUnitFieldOfView` function in TypeScript, ensuring it adheres to the specified guidelines. The function should be observable, output, state changes, filtering, and edge cases. It should also not include any external dependencies or hidden implementation details."},{"role":"assistant","content":"export function recalculateUnitFieldOfView(state: GameMap, action: RecalculateUnitFieldOfViewReducerAction): GameMap {\n  const units = state.getAllAliveUnitsArray();\n\n  for (const unit of units) {\n    if (unit.fieldOfView.rays.length === 0 || unit.distanceToHero > unit.fieldOfView.range) {\n      continue;\n    }\n\n    const vehicle = unit.getVehicleInUse();\n    const entitiesInView: { [id: string]: Building | Unit | Vehicle } = {};\n\n    for (const coordinates of unit.fieldOfView.cellsInView) {\n      const entity = state.getEntityByCoordinates(coordinates);\n\n      if (entity && entity.id !== unit.id && entity.id !== vehicle?.id) {\n        entitiesInView[entity.id] = entity;\n      }\n    }\n\n    unit.fieldOfView.castRays(Object.values(entitiesInView));\n  }\n\n  return state;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","RecalculateUnitFieldOfViewReducerAction","Building","Unit","Vehicle"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/game/unit/recalcUnitFieldOfView.ts","source_lines":"11-34","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"recalculateUnitFieldOfView","target_sha256":"7d7a53a8009910322c6863855aa20c3d2579711c57a35ba636a470e17ed54738","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Impleme