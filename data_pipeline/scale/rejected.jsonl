{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0363","messages":[{"role":"user","content":"Implement the `damageCreep` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"export function damageCreep(w: World, c: Creep, amount: number, source?: Tower): void {\n  if (c.dead || c.hp <= 0) return;\n\n  const def = ENEMIES[c.defId];\n\n  // Any hit restarts the regen countdown, whether or not a shield is up. That\n  // is what makes sustained fire hold a Warden's shield at zero while a gap in\n  // coverage hands it back.\n  c.shieldTimer = def.shieldRegenDelay;\n\n  // Armour comes off the individual hit, before anything else can absorb it.\n  // Splash arrives here too, which is deliberate â€” the falloff edge of a\n  // detonation is a small hit and armour treats it like one.\n  const effective = effectiveDamage(amount, def.armor);\n\n  // Shield absorbs next, and the overflow carries into the hull â€” so a single\n  // heavy shot is not wasted on a thin shield the way it would be if the shield\n  // simply ate the whole hit.\n  let toHull = effective;\n  let toShield = 0;\n  if (c.shield > 0) {\n    toShield = Math.min(c.shield, toHull);\n    c.shield -= toShield;\n    toHull -= toShield;\n    if (c.shield === 0) w.events.push({ type: 'shieldBroke', x: c.x, y: c.y });\n  }\n\n  // Credit shield and hull alike, but never more than was actually there, so\n  // overkill on a 2hp creep doesn't inflate a tower's damage figure.\n  const landed = Math.min(effective, effective - toHull + c.hp);\n  c.hp -= toHull;\n\n  if (source !== undefined) source.damageDealt += landed;\n  w.events.push({\n    type: 'creepDamaged',\n    id: c.id,\n    x: c.x,\n    y: c.y,\n    amount: landed,\n    toShield,\n    defId: source?.defId ?? null,\n  });\n\n  if (c.hp > 0) return;\n\n  c.dead = true;\n  // Paid to whoever's board this is, which for a sortie means the *defender*\n  // collects. That is the whole anti-spam valve of the duel economy and it\n  // needs no code of its own: bounty has always been credited to the world the\n  // contact died in, and a sortie dies in the world it was sent to.\n  w.money += c.bounty;\n  w.stats.kills++;\n  w.stats.bounty += c.bounty;\n\n  // Run totals count every kill; the per-wave itemisation counts only what the\n  // wave machine dispatched. A sortie has no wave to be itemised against, and\n  // charging it to whichever wave happened to be spawning would put kills in a\n  // clear summary that the wave never contained.\n  if (c.origin === 'wave') {\n    const wave = waveStats(w, c.wave);\n    wave.kills++;\n    wave.bounty += c.bounty;\n  }\n\n  if (source !== undefined) source.kills++;\n  w.events.push({ type: 'creepKilled', x: c.x, y: c.y, bounty: c.bounty, defId: c.defId });\n\n  // Queued, never spawned here. `stepProjectiles` is iterating `w.creeps` when\n  // this runs, and a push mid-iteration would let the very shot that made the\n  // kill also strike a child that did not exist when it was fired.\n  const split = ENEMIES[c.defId].splitInto;\n  if (split !== null) {\n    w.pendingSplits.push({ parent: c, into: split.enemy as EnemyId, count: split.count });\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","Creep","Tower","ENEMIES","Any","That","Warden","Armour","Splash","Shield","Credit","Paid"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/damage.ts","source_lines":"36-110","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"damageCreep","target_sha256":"7705a74700160831af32f27cb9d29566eb4eb8b2812ba425d061bba6df74d709","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `damageCreep` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":30.598},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0363","target_sha256":"7705a74700160831af32f27cb9d29566eb4eb8b2812ba425d061bba6df74d709","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":23.286},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0095","target_jaccard":0.1134,"instruction_nearest":"scale-rjct-react-isometric-game-0095","instruction_jaccard":0.1389},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0098","messages":[{"role":"user","content":"Implement the `recalculateUnitDistanceToScreenCenter` function in TypeScript, ensuring it adheres to the specified requirements. The function should take a `GameMap`, an `action` of type `RecalculateUnitDistanceToScreenCenterReducerAction`, and return a new `GameMap`. The function should handle various edge cases such as when the map size"},{"role":"assistant","content":"export function recalculateUnitDistanceToScreenCenter(\n  state: GameMap,\n  action: RecalculateUnitDistanceToScreenCenterReducerAction,\n): GameMap {\n  if (state.mapSize.width === 0) return state;\n\n  const { unit, viewport, scroll } = action;\n\n  const screenCenter = (viewport.screen.x2 - viewport.screen.x1) / 2;\n  const heroScreenX =\n    gridToScreenSpace(unit.position.grid, state.mapSize).x - scroll.x + constants.wireframeTileSize.width / 2;\n  const distance = ((heroScreenX * 100) / screenCenter - 100) / 100;\n\n  if (distance < Infinity) {\n    unit.setDistanceToScreenCenter(distance);\n  }\n\n  return state;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","RecalculateUnitDistanceToScreenCenterReducerAction","Infinity"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/game/unit/recalcUnitDistanceToScreenCenter.ts","source_lines":"14-32","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"recalculateUnitDistanceToScreenCenter","target_sha256":"ae8ab687630d32adc6af7c1ed4a378106695e916c6756e842f208df9f352b08b","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `recalculateUnitDistanceToScreenCenter` function in TypeScript, ensuring it adheres to the specified requirements. The function should take a `GameMap`, an `action` of type `RecalculateUnitDistanceToScreenCenterReducerAction`, and return a new `GameMap`. The function should handle various edge cases such as when the map size","batch_seconds":30.598},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0098","target_sha256":"ae8ab687630d32adc6af7c1ed4a378106695e916c6756e842f208df9f352b08b","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":23.286},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0095","target_jaccard":0.1143,"instruction_nearest":"scale-rjct-react-isometric-game-0095","instruction_jaccard":0.2037},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED","UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0101","messages":[{"role":"user","content":"Implement the `detectFiredAmmoHitsTarget` function in TypeScript, ensuring it adheres to the provided signature and provides detailed documentation."},{"role":"assistant","content":"export function detectFiredAmmoHitsTarget(state: GameMap) {\n  state.ammoFiredIds.forEach((ammoId) => {\n    const ammo = state.getAmmoById(ammoId);\n\n    if (ammo && ammo.isTargetReached) {\n      const weapon = ammo.loadedInWeapon!;\n      const shooter = weapon.owner as Unit;\n      const weaponBlastDamage = weapon?.getCurrentAttackModeDetails().blastRadius;\n      const blastDamage = calcBlastDamage(\n        ammo.position.grid,\n        weaponBlastDamage || 0,\n        calcDamage(shooter, weapon, ammo),\n      );\n\n      const unitsAtTargetArea = state.getUnitsByCoordinatesInRadius(ammo.position.grid, weaponBlastDamage);\n\n      for (const unit of unitsAtTargetArea) {\n        if (unit.isDead || !weapon) continue;\n\n        const { x, y } = unit.getRoundedPosition();\n        const damage = blastDamage[`${x}:${y}`];\n\n        if (damage) {\n          unit.takeDamage(damage, state);\n        }\n\n        if (unit.isDead) {\n          shooter.characteristics.earnXp(unit.dictEntity.rewardXpPoints);\n          state.deOccupyCell(unit.getRoundedPosition());\n          unit.blocksRays = false;\n        }\n      }\n    }\n  });\n\n  return state;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","Unit"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/detectFiredAmmoHitsTarget.ts","source_lines":"9-45","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"detectFiredAmmoHitsTarget","target_sha256":"552c0c6bba09ae40139d7b5f3deaca60ef24641a2c2398e2a8fa8d71543ef423","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `detectFiredAmmoHitsTarget` function in TypeScript, ensuring it adheres to the provided signature and provides detailed documentation.\"\n}\n```","batch_seconds":30.598},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0101","target_sha256":"552c0c6bba09ae40139d7b5f3deaca60ef24641a2c2398e2a8fa8d71543ef423","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":23.286},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0099","target_jaccard":0.2029,"instruction_nearest":"scale-rjct-react-isometric-game-0095","instruction_jaccard":0.1707},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0102","messages":[{"role":"user","content":"Implement the `animateVehiclesMove` function in TypeScript, ensuring it adheres to the provided signature and provides clear documentation."},{"role":"assistant","content":"export function animateVehiclesMove(state: GameMap, action: AnimateVehiclesMoveReducerAction) {\n  let isStateChanged = false;\n\n  for (const vehicle of action.entities) {\n    if (vehicle.path.length === 0 || vehicle.speed.current === 0) continue;\n\n    isStateChanged = true;\n    state.setGridMatrixOccupancy([vehicle], -1);\n\n    const entityPosition = { ...vehicle.position.grid };\n\n    if (vehicle.isCollisionDetected()) {\n      vehicle.setPosition(calcCollisionRollbackPosition(vehicle), state);\n      vehicle.setRotation(normalizeRotation(vehicle.realRotation.deg, 4));\n\n      vehicle.stop();\n      vehicle.setAction(\"collision\");\n\n      state.setGridMatrixOccupancy([vehicle], 1);\n\n      continue;\n    }\n\n    vehicle.pathQueue.points = vehicle.path;\n    vehicle.pathQueue.currentPos = vehicle.position.grid;\n    vehicle.pathQueue.destinationPos = vehicle.path[vehicle.path.length - 1];\n\n    const speed = vehicle.getCurrentSpeed();\n    const prevPoint = vehicle.pathQueue.moveAlong(action.deltaTime * speed);\n\n    if (prevPoint) {\n      vehicle.setPosition(prevPoint, state);\n    }\n\n    if (getDistanceBetweenGridPoints(vehicle.pathQueue.currentPos, entityPosition) > 0) {\n      const reverseAngle = vehicle.gearShiftMode === \"reverse\" ? 180 : 0;\n      const angle = getAngleBetweenTwoGridPoints(vehicle.pathQueue.currentPos, entityPosition, undefined, reverseAngle);\n\n      vehicle.setRotation(angle);\n    }\n\n    vehicle.setPosition(vehicle.pathQueue.currentPos, state);\n\n    if (vehicle.pathQueue.atEnd) {\n      vehicle.stop();\n\n      vehicle.setPositionComplete();\n    }\n\n    state.setGridMatrixOccupancy([vehicle], 1);\n  }\n\n  return isStateChanged ? { ...state } : state;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","AnimateVehiclesMoveReducerAction"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/game/vehicle/animateVehicleMove.ts","source_lines":"14-67","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"animateVehiclesMove","target_sha256":"b2a97d09f9bea5291c5989e681184573cea413cc979be7699cb41d4ef70fc353","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `animateVehiclesMove` function in TypeScript, ensuring it adheres to the provided signature and provides clear documentation.\"\n}\n```","batch_seconds":30.598},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0102","target_sha256":"b2a97d09f9bea5291c5989e681184573cea413cc979be7699cb41d4ef70fc353","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":23.286},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0099","target_jaccard":0.2568,"instruction_nearest":"scale-rjct-react-isometric-game-0095","instruction_jaccard":0.1707},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-baterson-svelte-tower-defence-0284","messages":[{"role":"user","content":"Implement the `LootTracker` class with the following features:\n\n- **Observable Inputs**: `collectedLoot`, `playLowLootAnimation`, `playTowerUpgradeAnimation`, `playEnemyClickAnimation`, `score`, `killsEnemy`\n\n- **Observable Outputs**: `null`\n\n- **State Changes**: `null"},{"role":"assistant","content":"export class LootTracker {\n\tcollectedLoot = $state(100);\n\tplayLowLootAnimation = $state(false);\n\tplayTowerUpgradeAnimation = $state(false);\n\tplayEnemyClickAnimation = $state(false);\n\tscore = $state(100);\n\tkillsEnemy = $state(0);\n\n\tspendLoot(action) {\n\t\tconst toSpend = LOOT_MAP[action.type];\n\n\t\tif (this.collectedLoot < toSpend) {\n\t\t\tthis.playAnimation('LowLoot');\n\t\t\t// soundManager.play('lowResourse');\n\t\t\treturn;\n\t\t}\n\n\t\tif (action.type === 'upgrade') {\n\t\t\tconst { tower } = action.payload;\n\t\t\tthis.collectedLoot -= toSpend;\n\n\t\t\ttower.state.setState('Upgrade');\n\t\t\tthis.playAnimation('TowerUpgrade');\n\n\t\t\tcursor.setAnimation('TowerBuildCursor');\n\t\t} else if (action.type === 'click') {\n\t\t\tconst { collisionManager, stageManager } = managers.get(['collisionManager', 'stageManager']);\n\t\t\tconst { offset } = action.payload;\n\n\t\t\tconst boundingBox = boundingBoxFromPoint(offset, 60, 60);\n\t\t\tconst enemies = collisionManager.filterEnemiesByBounds(boundingBox);\n\n\t\t\tstageManager.spawnEntity('ClickExplode', offset);\n\t\t\tsoundManager.play('clickEnemy', true);\n\n\t\t\tenemies.forEach((enemy) => {\n\t\t\t\tenemy.state.setState('Die');\n\t\t\t});\n\n\t\t\tif (enemies.length > 0) {\n\t\t\t\tthis.collectedLoot -= toSpend;\n\t\t\t}\n\t\t}\n\t}\n\n\treceiveLoot(loot) {\n\t\tthis.collectedLoot += loot;\n\t\tthis.score += loot;\n\t\tthis.killsEnemy++;\n\t}\n\treset() {\n\t\tthis.collectedLoot = 100;\n\t\tthis.killsEnemy = 0;\n\t}\n\n\tgetAnimation(name) {\n\t\treturn `play${name}Animation`;\n\t}\n\n\tplayAnimation(name) {\n\t\tconst animation = this.getAnimation(name);\n\t\tthis[animation] = true;\n\t}\n\n\tunsetAnimation(name) {\n\t\tconst animation = this.getAnimation(name);\n\t\tthis[animation] = false;\n\t}\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["LOOT_MAP","LowLoot","Upgrade","TowerUpgrade","TowerBuildCursor","ClickExplode","Die","Animation"]},"metadata":{"source_repo":"baterson/svelte-tower-defence","source_commit":"158cd98dbf81ab08a3abaa9b5d00b43b16ffe41a","source_path":"src/lib/store/LootTracker.svelte.ts","source_lines":"11-79","repository_family_id":"github-family:baterson/svelte-tower-defence","license":"MIT","category":"tower-defense","granularity":"G2","symbol":"LootTracker","target_sha256":"39f79c835c25b2e4084e53f2552631cdbc132bdfb40b1c27ba619032b3c8ade9","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `LootTracker` class with the following features:\\n\\n- **Observable Inputs**: `collectedLoot`, `playLowLootAnimation`, `playTowerUpgradeAnimation`, `playEnemyClickAnimation`, `score`, `killsEnemy`\\n\\n- **Observable Outputs**: `null`\\n\\n- **State Changes**: `null","batch_seconds":23.603},"independent_review":{"unit_id":"scale-baterson-svelte-tower-defence-0284","target_sha256":"39f79c835c25b2e4084e53f2552631cdbc132bdfb40b1c27ba619032b3c8ade9","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":24.288},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-baterson-svelte-tower-defence-0283","target_jaccard":0.1705,"instruction_nearest":"scale-rjct-react-isometric-game-0099","instruction_jaccard":0.1081},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED"]}}
{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0364","messages":[{"role":"user","content":"Create a world with the specified parameters and rules."},{"role":"assistant","content":"export function createWorld(map: MapDef, seed: number, rules: Rules = DEFAULT_RULES): World {\n  return {\n    seed,\n    map,\n    rules,\n    tick: 0,\n    time: 0,\n    phase: 'playing',\n    lives: rules.startingLives,\n    money: rules.startingMoney,\n    era: 1,\n    eraSpent: 0,\n    wave: {\n      index: 0,\n      phase: 'intermission',\n      timer: BALANCE.firstWaveDelay,\n      plan: [],\n      spawned: 0,\n      dispatchedThrough: -1,\n      clearedThrough: -1,\n    },\n    creeps: [],\n    towers: [],\n    projectiles: [],\n    pendingSplits: [],\n    stats: {\n      kills: 0,\n      leaks: 0,\n      bounty: 0,\n      spent: 0,\n      sortiesSent: 0,\n      sortieSpend: 0,\n      sortieEarned: 0,\n      sortiesTaken: 0,\n    },\n    perWave: [],\n    commands: [],\n    events: [],\n    nextId: 1,\n  };\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["MapDef","Rules","DEFAULT_RULES","World","BALANCE"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/world.ts","source_lines":"142-182","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"createWorld","target_sha256":"9455a66682eaeaf973338de9ff3d018f3a4a483c38c46d9c6bdedbc143a45875","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Create a world with the specified parameters and rules.\"\n}\n```","batch_seconds":23.603},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0364","target_sha256":"9455a66682eaeaf973338de9ff3d018f3a4a483c38c46d9c6bdedbc143a45875","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":