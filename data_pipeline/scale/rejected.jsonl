{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0247","messages":[{"role":"user","content":"Implement the `melee` function in TypeScript, following the provided signature and constraints."},{"role":"assistant","content":"function melee(\n  state: BattleState,\n  attacker: BattleStack,\n  target: BattleStack,\n  rng: Rng,\n  hexesMoved: number,\n): void {\n  const info = creature(attacker.creature);\n  const hits = hasTrait(info, 'double_attack') ? 2 : 1;\n\n  for (let i = 0; i < hits && isAlive(target); i++) {\n    strike(state, attacker, target, rng, false, hexesMoved);\n  }\n\n  // Contraataque: uno por ronda, y solo si el atacante lo permite.\n  if (\n    isAlive(target) &&\n    isAlive(attacker) &&\n    !target.retaliated &&\n    !hasTrait(info, 'no_retaliation') &&\n    canReachMelee(target, attacker)\n  ) {\n    // El contraataque no carga: se devuelve el golpe desde donde se estÃ¡.\n    target.retaliated = true;\n    strike(state, target, attacker, rng, true, 0);\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["BattleState","BattleStack","Rng","Contraataque","El"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/core/battle/battle.ts","source_lines":"522-548","repository_family_id":"github-family:alberto-hortelano/heroes-of-silence","license":"MIT","category":"tactics","granularity":"G1","symbol":"melee","target_sha256":"63933521e81313d6c549b16818b42c536c73ae81b7d3da990822d813b3b69c4e","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `melee` function in TypeScript, following the provided signature and constraints.\"\n}\n```","batch_seconds":21.231},"independent_review":{"unit_id":"scale-alberto-hortelano-heroes-of-silence-0247","target_sha256":"63933521e81313d6c549b16818b42c536c73ae