{"schema_version":"1.0","sample_id":"scale-djpav-threejs-tower-defense-0402","messages":[{"role":"user","content":"Implement the `ProjectileManager` class with the following features:\n\n- **Projectile Class**: A class to manage projectiles in a tower-defense game.\n\n- **Projectile Properties**: Includes properties like `x`, `y`, `z`, `target`, `config`, and `impactPosition`.\n\n- **Projectile Methods**: Methods to spawn"},{"role":"assistant","content":"export class ProjectileManager {\n  private projectiles: Projectile[] = [];\n  private group: Group;\n  private impactHandler: ImpactHandler;\n  private effectManager: EffectManager | null = null;\n  private pool = new ObjectPool<Projectile>(() => new Projectile());\n\n  constructor(group: Group, enemyManager: EnemyManager) {\n    this.group = group;\n    this.impactHandler = new ImpactHandler(enemyManager);\n  }\n\n  setEffectManager(em: EffectManager): void {\n    this.effectManager = em;\n    this.impactHandler.setEffectManager(em);\n  }\n\n  spawn(\n    x: number,\n    y: number,\n    z: number,\n    target: Enemy,\n    config: TowerConfig,\n  ): Projectile {\n    const projectile = this.pool.acquire();\n    projectile.reset(x, y, z, target, config);\n    this.projectiles.push(projectile);\n    this.group.add(projectile.getObject3D());\n    return projectile;\n  }\n\n  update(delta: number): void {\n    for (let i = this.projectiles.length - 1; i >= 0; i--) {\n      const p = this.projectiles[i];\n      p.update(delta);\n      if (!p.alive) {\n        if (p.impactPosition) {\n          this.impactHandler.handleImpact(p);\n          if (this.effectManager) {\n            this.effectManager.spawnImpactFlash(\n              p.impactPosition.x,\n              p.impactPosition.y,\n              p.impactPosition.z,\n              p.towerConfig.projectileColor,\n            );\n          }\n        }\n        this.group.remove(p.getObject3D());\n        this.pool.release(p);\n        this.projectiles[i] = this.projectiles[this.projectiles.length - 1];\n        this.projectiles.pop();\n      }\n    }\n  }\n\n  dispose(): void {\n    for (const p of this.projectiles) {\n      this.group.remove(p.getObject3D());\n    }\n    this.projectiles = [];\n    this.pool.disposeAll((p) => p.dispose());\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["Projectile","Group","ImpactHandler","EffectManager","ObjectPool","EnemyManager","Enemy","TowerConfig"]},"metadata":{"source_repo":"djpav/threejs-tower-defense","source_commit":"dcb33e163c96e03d464d868b5b91ca5af93fe4f2","source_path":"src/systems/ProjectileManager.ts","source_lines":"10-72","repository_family_id":"github-family:djpav/threejs-tower-defense","license":"MIT","category":"tower-defense","granularity":"G2","symbol":"ProjectileManager","target_sha256":"bc7d3f2e6f4808d317031e1f572f9352a3731f45517eab9df4ed5654d1207a2a","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `ProjectileManager` class with the following features:\\n\\n- **Projectile Class**: A class to manage projectiles in a tower-defense game.\\n\\n- **Projectile Properties**: Includes properties like `x`, `y`, `z`, `target`, `config`, and `impactPosition`.\\n\\n- **Projectile Methods**: Methods to spawn","batch_seconds":26.259},"independent_review":{"unit_id":"scale-djpav-threejs-tower-defense-0402","target_sha256":"bc7d3f2e6f4808d317031e1f572f9352a3731f45517eab9df4ed5654d1207a2a","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":24.288},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0094","target_jaccard":0.1136,"instruction_nearest":"scale-baterson-svelte-tower-defence-0283","instruction_jaccard":0.2}