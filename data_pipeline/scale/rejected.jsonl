{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0252","messages":[{"role":"user","content":"Implement the `mejorCarga` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"function mejorCarga(\n  state: BattleState,\n  s: BattleStack,\n  objetivo: BattleStack,\n  cargas: readonly CargaContra[],\n  costes: ReadonlyMap<string, Paso>,\n): BattleAction {\n  const miHeroe = state.heroes[s.side];\n  const suHeroe = state.heroes[objetivo.side];\n  // Sin el rasgo, `expectedDamage` da lo MISMO desde cualquier casilla: la\n  // fÃ³rmula no mira el hex mÃ¡s que por la carga. No es una optimizaciÃ³n, es lo\n  // que significa â€” evaluarla casilla a casilla serÃ­a preguntar seis veces algo\n  // cuya respuesta no depende de la pregunta. Con el daÃ±o empatado decide el\n  // desempate, que es lo que decide hoy el 100 % de los casos.\n  const cobraCarga = hasTrait(creature(s.creature), 'charge');\n\n  let mejor = cargas[0] as CargaContra;\n  let mejorDano = -1;\n  let mejorCoste = Number.POSITIVE_INFINITY;\n  for (const a of cargas) {\n    const paso = costes.get(hexKey(a.from));\n    // Inalcanzable salvo que la lista legal y su propio mapa discrepen: los\n    // `from` salen de las claves de ese mapa. Si algÃºn dÃ­a discrepan, se dice;\n    // no se elige una casilla a ciegas.\n    if (paso === undefined) {\n      throw new Error(`${s.id} no alcanza (${a.from.col},${a.from.row}): la lista legal miente`);\n    }\n    const coste = paso.steps;\n    const dano = cobraCarga\n      ? expectedDamage(s, miHeroe, objetivo, suHeroe, { chargeHexes: coste })\n      : 0;\n    if (dano > mejorDano || (dano === mejorDano && coste < mejorCoste)) {\n      mejor = a;\n      mejorDano = dano;\n      mejorCoste = coste;\n    }\n  }\n  return mejor;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["BattleState","BattleStack","CargaContra","ReadonlyMap","Paso","BattleAction","Sin","MISMO","No","Con","POSITIVE_INFINITY","Inalcanzable"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/core/ai/tactics.ts","source_lines":"174-212","repository_family_id":"github-family:alberto-hortelano/heroes-of-silence","license":"MIT","category":"tactics","granularity":"G1","symbol":"mejorCarga","target_sha256":"cec03f71990897275c06eb46c98d400f25c2bc06e628534bfc865b42ef0f8f6d","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `mejorCarga` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":27.746},"independent_review":{"unit_id":"scale-alberto-hortelano-heroes-of-silence-0252","target_sha256":"cec03f71990897275c06eb46c98d400f25c2bc06e628534bfc865b42ef0f8f6d","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":79.734},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-alberto-hortelano-heroes-of-silence-0244","target_jaccard":0.25,"instruction_nearest":"scale-cbhead-deep-field-td-0393","instruction_jaccard":0.3333},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0255","messages":[{"role":"user","content":"Implement the `drawAdventure` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"export function drawAdventure(ctx: CanvasRenderingContext2D, view: AdventureView): void {\n  const { state, camera } = view;\n  const player = state.players.find((p) => p.id === view.viewer);\n  ctx.save();\n  ctx.imageSmoothingEnabled = false;\n  ctx.translate(camera.offsetX, camera.offsetY);\n\n  for (let row = 0; row <= camera.rows; row++) {\n    for (let col = 0; col <= camera.cols; col++) {\n      const p = { x: camera.origin.x + col, y: camera.origin.y + row };\n      if (p.x >= state.map.width || p.y >= state.map.height) continue;\n\n      const sx = col * TILE;\n      const sy = row * TILE;\n      const terreno = state.map.terrain[p.y * state.map.width + p.x] as TerrainKind;\n      const textura = asset('terrains', terreno);\n      if (textura === null) {\n        ctx.fillStyle = TERRAIN_COLORS[terreno];\n        ctx.fillRect(sx, sy, TILE, TILE);\n      } else {\n        ctx.drawImage(textura, sx, sy, TILE, TILE);\n      }\n\n      if (state.map.roads.has(pointKey(p))) {\n        ctx.fillStyle = 'rgba(200,180,140,0.35)';\n        ctx.fillRect(sx + TILE * 0.3, sy + TILE * 0.3, TILE * 0.4, TILE * 0.4);\n      }\n\n      ctx.strokeStyle = 'rgba(0,0,0,0.18)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(sx + 0.5, sy + 0.5, TILE - 1, TILE - 1);\n\n      const explorada = view.revealAll || (player?.fog.has(pointKey(p)) ?? false);\n      if (!explorada) {\n        ctx.fillStyle = 'rgba(6,5,4,0.88)';\n        ctx.fillRect(sx, sy, TILE, TILE);\n      }\n    }\n  }\n\n  // Objetos y hÃ©roes, solo donde se ve.\n  for (const obj of state.map.objects) {\n    if (!isVisible(view, obj.at)) continue;\n    const pos = toScreen(camera, obj.at);\n    if (pos === null) continue;\n    drawObject(ctx, obj, pos.x, pos.y);\n  }\n\n  for (const hero of state.heroes) {\n    if (!isVisible(view, hero.at)) continue;\n    const pos = toScreen(camera, hero.at);\n    if (pos === null) continue;\n    drawHero(ctx, hero, pos.x, pos.y, hero.id === view.selectedHero);\n  }\n\n  drawPath(ctx, camera, view.hoverPath);\n  ctx.restore();\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["CanvasRenderingContext2D","AdventureView","TILE","TerrainKind","TERRAIN_COLORS","Objetos"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/client/render/adventure.ts","source_lines":"102-159","repository_family_id":"github-family:alberto-hortelano/heroes-of-silence","license":"MIT","category":"tactics","granularity":"G1","symbol":"drawAdventure","target_sha256":"7063c7620d18b437b87306cab1586d3de89d664bf6d002f8d6ee6a5a1fd8b7ff","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `drawAdventure` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":27.746},"independent_review":{"unit_id":"scale-alberto-hortelano-heroes-of-silence-0255","target_sha256":"7063c7620d18b437b87306cab1586d3de89d664bf6d002f8d6ee6a5a1fd8b7ff","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":79.734},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-alberto-hortelano-heroes-of-silence-0239","target_jaccard":0.1788,"instruction_nearest":"scale-cbhead-deep-field-td-0393","instruction_jaccard":0.3333},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0256","messages":[{"role":"user","content":"Implement the `settleBattle` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"export function settleBattle(state: GameState, _ctx: GameContext): void {\n  const pending = state.pendingBattle;\n  if (pending === null) throw new Error('no hay batalla pendiente');\n  if (pending.battle.finished === null) throw new Error('la batalla no ha terminado');\n\n  const { winner } = pending.battle.finished;\n  const hero = heroById(state, pending.attackerHeroId);\n  // La casilla, LEÃDA AQUÃ: con los dos bandos todavÃ­a en pie. DespuÃ©s hay\n  // hÃ©roes que salen del mapa y castillos que cambian de bandera, y preguntar\n  // entonces serÃ­a preguntar por alguien que ya no estÃ¡. Es el mismo patrÃ³n que\n  // el `const dueÃ±o = hero.owner` de mÃ¡s abajo, y por eso el dato no hace falta\n  // guardarlo en `PendingBattle`.\n  const at = battleAt(state, pending);\n  const superviviente = (side: 'attacker' | 'defender'): Army => {\n    const slots: (Stack | null)[] = [null, null, null, null, null];\n    for (const s of pending.battle.stacks) {\n      if (s.side !== side || s.count <= 0) continue;\n      slots[s.slot] = { creature: s.creature, count: s.count };\n    }\n    return pruneArmy(slots);\n  };\n\n  restoreHeroFromBattle(hero, pending.battle.heroes.attacker, superviviente('attacker'));\n  const heroeAtacanteVivo = winner === 'attacker';\n\n  // El cierre de la batalla se registra ANTES de sus consecuencias: capturar\n  // el Ãºltimo pueblo del rival termina la partida, y \"game_over\" tiene que ser\n  // el Ãºltimo evento del registro, no quedar sepultado bajo el de la batalla.\n  emit(state, {\n    kind: 'battle_ended',\n    winner,\n    foe: pending.foe,\n    actor: hero.owner,\n    at,\n  });\n  state.pendingBattle = null;\n\n  if (heroeAtacanteVivo) {\n    ganarExperiencia(state, hero, experienceFor(pending, 'attacker'), at);\n    applyVictory(state, hero, pending.foe, at);\n  } else {\n    // El atacante derrotado desaparece del mapa con su ejÃ©rcito. Su dueÃ±o se\n    // lee ANTES del filtro: un instante despuÃ©s el hÃ©roe ya no estÃ¡ y el evento\n    // que cuenta su muerte no tendrÃ­a a quiÃ©n atribuirse â€” que es justo por quÃ©\n    // el 10,9 % de la crÃ³nica era inatribuible.\n    const dueÃ±o = hero.owner;\n    state.heroes = state.heroes.filter((h) => h.id !== hero.id);\n    emit(state, { kind: 'hero_defeated', hero: hero.id, actor: dueÃ±o, at });\n    applyDefenderSurvivors(state, pending, superviviente('defender'), at);\n  }\n\n  checkDefeat(state);\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameState","GameContext","Error","La","LE","DA","AQU","Despu","Es","PendingBattle","Army","Stack"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/core/state/game.ts","source_lines":"1238-1290","repository_family_id":"github-family:alberto-hortelano/heroes-of-silence","license":"MIT","category":"tactics","granularity":"G1","symbol":"settleBattle","target_sha256":"b55fb2625fb61bf8fdcc154cf42b85f6d041d74573eadcac045ec0ceb805535c","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `settleBattle` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":27.746},"independent_review":{"unit_id":"scale-alberto-hortelano-heroes-of-silence-0256","target_sha256":"b55fb2625fb61bf8fdcc154cf42b85f6d041d74573eadcac045ec0ceb805535c","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":79.734},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass"