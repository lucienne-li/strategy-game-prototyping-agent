{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0378","messages":[{"role":"user","content":"Create a renderer for a tower-defense game using Pixi.js. The renderer should be able to render a map, towers, creeps, projectiles, effects, and an overlay. It should also handle viewport updates and resize events."},{"role":"assistant","content":"export async function createRenderer(\n  mount: HTMLElement,\n  width: number,\n  height: number,\n  field: SectorField,\n): Promise<Renderer> {\n  const app = new Application();\n\n  // v8: init() is ASYNC. (v7's `new Application({...})` is gone â€” most tutorials\n  // online are still v7 and will not work.)\n  await app.init({\n    width,\n    height,\n    background: field.bg,\n\n    // Crisp on retina without changing our logical coordinate space.\n    resolution: window.devicePixelRatio || 1,\n    autoDensity: true,\n\n    antialias: true,\n\n    // We drive rendering from our own fixed-timestep loop, so Pixi must not\n    // start its own ticker. See src/app/loop.ts.\n    autoStart: false,\n\n    // WebGL rather than WebGPU: fewer driver edge cases, and nothing here needs\n    // compute. Revisit only if profiling ever says to.\n    preference: 'webgl',\n  });\n\n  // v8: `app.canvas`, not `app.view`.\n  mount.appendChild(app.canvas);\n\n  fitCanvas(app);\n  watchViewport(() => {\n    fitCanvas(app);\n  });\n\n  const layers: Layers = {\n    map: new Container(),\n    towers: new Container(),\n    creeps: new Container(),\n    projectiles: new Container(),\n    effects: new Container(),\n    overlay: new Container(),\n  };\n\n  app.stage.addChild(\n    layers.map,\n    layers.towers,\n    layers.creeps,\n    layers.projectiles,\n    layers.effects,\n    layers.overlay,\n  );\n\n  return { app, layers };\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["HTMLElement","SectorField","Renderer","Application","ASYNC","Crisp","We","Pixi","See","WebGL","WebGPU","Revisit"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/render/pixiApp.ts","source_lines":"31-88","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"createRenderer","target_sha256":"4ae4329b4b466a7e6d1a82cf9a3dfca5ae1847f07651fec991ab498dc028ab73","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Create a renderer for a tower-defense game using Pixi.js. The renderer should be able to render a map, towers, creeps, projectiles, effects, and an overlay. It should also handle viewport updates and resize events.\"\n}\n```","batch_seconds":25.351},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0378","target_sha256":"4ae4329b4b466a7e6d1a82cf9a3dfca5ae1847f07651fec991ab498dc028ab73","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":63.449},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0120","target_jaccard":0.0952,"instruction_nearest":"scale-cbhead-deep-field-td-0369","instruction_jaccard":0.2157},"status":"rejected","rejection_reasons":["SYMBOL_NOT_NAMED"]}}
{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0381","messages":[{"role":"user","content":"Build end markers for a tower-defense game using TypeScript. The markers should be placed on the board, with each marker representing a tile. The markers should be colored based on the number of tiles they touch, and the markers should be positioned such that they are above the board. The markers should also have a bloom effect that grows with the number of tiles they"},{"role":"assistant","content":"function buildEndMarkers(map: MapDef, field: SectorField): Graphics {\n  const g = new Graphics();\n\n  // One chevron per *entry tile*, not per lane. Crown runs four lanes out of\n  // two spawns, and stacking two chevrons on one tile just draws it darker.\n  const drawn = new Set<string>();\n\n  for (const route of map.routes) {\n    // The spawn point sits one tile off-board; draw the chevron on the first\n    // on-board tile instead, pointing the way creeps will travel.\n    const entry = route.waypoints[0]!;\n    const first = route.waypoints[1];\n    if (first === undefined) continue;\n\n    const key = `${first.x},${first.y}`;\n    if (drawn.has(key)) continue;\n    drawn.add(key);\n\n    const dx = Math.sign(first.x - entry.x);\n    const dy = Math.sign(first.y - entry.y);\n    const ax = first.x * TILE_PX;\n    const ay = first.y * TILE_PX;\n    const r = TILE_PX * 0.3;\n\n    // Tip points along travel; the base is the perpendicular through the centre.\n    g.moveTo(ax + dx * r, ay + dy * r)\n      .lineTo(ax - dx * r + dy * r, ay - dy * r + dx * r)\n      .lineTo(ax - dx * r - dy * r, ay - dy * r - dx * r)\n      .fill({ color: field.spawn, alpha: 0.85 });\n  }\n\n  const gx = map.goal.x * TILE_PX;\n  const gy = map.goal.y * TILE_PX;\n  const goal = field.goal;\n\n  // The bloom is the `falloff` sprite under the tile field, not a disc here â€”\n  // see the halos added in `buildMapLayer`. What is left in this Graphics is\n  // only what has to sit *above* the board: the rings and the core.\n  for (const [radius, width, alpha] of PULSAR_RINGS) {\n    g.circle(gx, gy, TILE_PX * radius).stroke({ width, color: goal, alpha });\n  }\n  // Core: a soft shoulder under a hard centre, so the middle blooms instead of\n  // sitting there as a flat dot the rings happen to be centred on. It grew with\n  // the rings â€” a 0.08-tile dot inside a 2.5-tile ring stack would read as a\n  // target the rings were aimed at rather than as the thing emitting them.\n  g.circle(gx, gy, TILE_PX * 0.34).fill({ color: goal, alpha: 0.16 });\n  g.circle(gx, gy, TILE_PX * 0.2).fill({ color: goal, alpha: 0.34 });\n  g.circle(gx, gy, TILE_PX * 0.11).fill({ color: goal, alpha: 0.95 });\n\n  return g;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["MapDef","SectorField","Graphics","One","Crown","The","TILE_PX","Tip","What","PULSAR_RINGS","Core","It"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/render/mapLayer.ts","source_lines":"681-731","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"buildEndMarkers","target_sha256":"8f46c8a2736b4b786b685c4a267f9d38ea10783a84eae9710d9233a1dab37926","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Build end markers for a tower-defense game using TypeScript. The markers should be placed on the board, with each marker representing a tile. The markers should be colored based on the number of tiles they touch, and the markers should be positioned such that they are above the board. The markers should also have a bloom effect that grows with the number of tiles they","batch_seconds":25.351},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0381","target_sha256":"8f46c8a2736b4b786b685c4a267f9d38ea10783a84eae9710d9233a1dab37926","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":63.449},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0107","target_jaccard":0.1731,"instruction_nearest":"scale-cbhead-deep-field-td-0379","instruction_jaccard":0.2075},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED","SYMBOL_NOT_NAMED"]}}
{"schema_version":"1.0","sample_id":"scale-djpav-threejs-tower-defense-0406","messages":[{"role":"user","content":"Implement the `TowerManager` class with the following features:\n\n- **Public Signature**: The class should be named `TowerManager` and have a public signature.\n\n- **Observable Inputs**: The class should accept an `Observable<Tower>` as input for managing towers.\n\n- **Outputs**: The class should provide methods to place,"},{"role":"assistant","content":"export class TowerManager {\n  private towers: Tower[] = [];\n  private group: Group;\n  private map: GameMap;\n  private distanceField: DistanceField;\n\n  constructor(group: Group, map: GameMap, distanceField: DistanceField) {\n    this.group = group;\n    this.map = map;\n    this.distanceField = distanceField;\n  }\n\n  getDistanceField(): DistanceField {\n    return this.distanceField;\n  }\n\n  canPlace(gridPos: GridPosition): boolean {\n    const cell = this.map.getCellAt(gridPos.row, gridPos.col);\n    return !!cell && cell.cellType === CellType.Buildable && !cell.occupied;\n  }\n\n  place(config: TowerConfig, gridPos: GridPosition): Tower | null {\n    if (!this.canPlace(gridPos)) return null;\n\n    const cell = this.map.getCellAt(gridPos.row, gridPos.col)!;\n    const worldPos = this.map.getWorldPosition(gridPos);\n    const tower = new Tower(config, gridPos, worldPos.x, worldPos.z);\n    cell.occupied = true;\n    this.towers.push(tower);\n\n    this.group.add(tower.getObject3D());\n    tower.startPlacementAnimation();\n    return tower;\n  }\n\n  remove(tower: Tower): void {\n    const cell = this.map.getCellAt(tower.gridPos.row, tower.gridPos.col);\n    if (cell) cell.occupied = false;\n    this.group.remove(tower.getObject3D());\n    tower.dispose();\n    const idx = this.towers.indexOf(tower);\n    if (idx !== -1) this.towers.splice(idx, 1);\n\n  }\n\n  getTowerAt(gridPos: GridPosition): Tower | undefined {\n    return this.towers.find(\n      (t) => t.gridPos.row === gridPos.row && t.gridPos.col === gridPos.col,\n    );\n  }\n\n  upgradeTower(tower: Tower, newConfig: TowerConfig): void {\n    tower.upgrade(newConfig);\n  }\n\n  getTowers(): readonly Tower[] {\n    return this.towers;\n  }\n\n  update(delta: number): void {\n    for (const tower of this.towers) {\n      tower.update(delta);\n    }\n  }\n\n  dispose(): void {\n    for (const tower of this.towers) {\n      this.group.remove(tower.getObject3D());\n      tower.dispose();\n    }\n    this.towers = [];\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["Tower","Group","GameMap","DistanceField","GridPosition","CellType","Buildable","TowerConfig"]},"metadata":{"source_repo":"djpav/threejs-tower-defense","source_commit":"dcb33e163c96e03d464d868b5b91ca5af93fe4f2","source_path":"src/systems/TowerManager.ts","source_lines":"8-80","repository_family_id":"github-family:djpav/threejs-tower-defense","license":"MIT","category":"tower-defense","granularity":"G2","symbol":"TowerManager","target_sha256":"f274dc105a1d612bbe3310c0e844514500df808ad524bba5ca420b73553c7a25","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `TowerManager` class with the following features:\\n\\n- **Public Signature**: The class should be named `TowerManager` and have a public signature.\\n\\n- **Observable Inputs**: The class should accept an `Observable<Tower>` as input for managing towers.\\n\\n- **Outputs**: The class should provide methods to place,","batch_seconds":24.456},"independent_review":{"unit_id":"scale-djpav-threejs-tower-defense-0406","target_sha256":"f274dc105a1d612bbe3310c0e844514500df808ad524bba5ca420b73553c7a25","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":63.449},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-excaliburjs-sample-tactics-0084","target_jaccard":0.17,"instruction_nearest":"scale-rjct-react-isometric-game-0107","instruction_jaccard":0.2174},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED"]}}
{"schema_version":"1.0","sample_id":"scale-djpav-threejs-tower-defense-0407","messages":[{"role":"user","content":"Implement the `generateBudgetWave` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"export function generateBudgetWave(\n  budget: number,\n  level: number,\n  availableTypes: EnemyConfig[],\n  rand: () => number,\n): WaveConfig {\n  const hpScale = calcHPScale(level);\n  const entries: WaveConfig[\"entries\"] = [];\n  let remaining = budget;\n\n  // Shuffle available types for variety\n  const shuffled = [...availableTypes];\n  for (let i = shuffled.length - 1; i > 0; i--) {\n    const j = Math.floor(rand() * (i + 1));\n    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n  }\n\n  for (const baseConfig of shuffled) {\n    if (remaining <= 0) break;\n\n    const category = classifyEnemy(baseConfig);\n    const cost = ENEMY_BUDGET_COST[category] ?? 5;\n    const maxCount = Math.floor(remaining / cost);\n    if (maxCount <= 0) continue;\n\n    // Random count between 1 and maxCount (biased toward fewer for expensive types)\n    const count =\n      cost >= 30\n        ? Math.min(maxCount, 1 + Math.floor(rand() * 2))\n        : Math.min(maxCount, 2 + Math.floor(rand() * (maxCount - 1)));\n\n    if (count <= 0) continue;\n\n    entries.push({\n      count,\n      spawnInterval: Math.max(0.3, 1.2 - level * 0.05),\n      enemyConfig: {\n        ...baseConfig,\n        hp: Math.round(baseConfig.hp * hpScale),\n        speed: baseConfig.speed + level * 0.05,\n        reward: Math.max(\n          1,\n          Math.round(baseConfig.reward * calcRewardScale(level)),\n        ),\n      },\n    });\n\n    remaining -= count * cost;\n  }\n\n  // If budget remains and we have entries, pad with basic enemies\n  if (remaining > 5 && entries.length > 0) {\n    const basicCost = ENEMY_BUDGET_COST[\"basic\"];\n    const padCount = Math.floor(remaining / basicCost);\n    if (padCount > 0) {\n      entries.push({\n        count: padCount,\n        spawnInterval: 0.8,\n        enemyConfig: {\n          ...BASIC_ENEMY,\n          hp: Math.round(BASIC_ENEMY.hp * hpScale),\n          speed: BASIC_ENEMY.speed + level * 0.05,\n          reward: Math.max(\n            1,\n            Math.round(BASIC_ENEMY.reward * calcRewardScale(level)),\n          ),\n        },\n      });\n    }\n  }\n\n  return { entries };\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["EnemyConfig","WaveConfig","Shuffle","ENEMY_BUDGET_COST","Random","If","BASIC_ENEMY"]},"metadata":{"source_repo":"djpav/threejs-tower-defense","source_commit":"dcb33e163c96e03d464d868b5b91ca5af93fe4f2","source_path":"src/configs/WaveGenerator.ts","source_lines":"245-317","repository_family_id":"github-family:djpav/threejs-tower-defense","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"generateBudgetWave","target_sha256":"ae7a3eea0eb6f5fcbe6d5b8879adab8fa6a62f49107809562a25f6c2d9c3771c","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `generateBudgetWave` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":24.456},"independent_review":{"unit_id":"scale-djpav-threejs-tower-defense-0407","target_sha256":"ae7a3eea0eb6f5fcbe6d5b8879adab8fa6a62f49107809562a25f6c2d9c3771c","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":63.449},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-djpav-threejs-tower-defense-0405","target_jaccard":0.2043,"instruction_nearest":"scale-rjct-react-isometric-game-0104","instruction_jaccard":0.2941},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0129","messages":[{"role":"user","content":"Implement the `highlightUnitAtGunpoint` function in the `GameMap` class, which takes a `state` object and an `action` object as parameters. The function should return a new `state` object with the `unitAtGunpoint` property set to the correct value based on the `action`. The `action` object should have"},{"role":"assistant","content":"export function highlightUnitAtGunpoint(state: GameMap, action: HighlightUnitAtGunpointReducerAction) {\n  const hero = state.getHero();\n  const weapon = hero?.getCurrentWeapon();\n\n  if (!weapon) return state;\n\n  const unitAtGunpoint =\n    !!weapon &&\n    weapon.isReadyToUse(state) &&\n    weapon.getAimCoordinates()?.x === action.unit.getRoundedPosition().x &&\n    weapon.getAimCoordinates()?.y === action.unit.getRoundedPosition().y;\n\n  const isChanged = action.unit.atGunpoint !== unitAtGunpoint;\n  action.unit.setAtGunpoint(unitAtGunpoint);\n\n  return isChanged ? { ...state } : state;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","HighlightUnitAtGunpointReducerAction"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/game/unit/highlightUnitAtGunpoint.ts","source_lines":"9-25","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"highlightUnitAtGunpoint","target_sha256":"e47e7905eab0b893560ba1f2d91457d357d310b0b88c95dc77566f9078c48412","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `highlightUnitAtGunpoint` function in the `GameMap` class, which takes a `state` object and an `action` object as parameters. The function should return a new `state` object with the `unitAtGunpoint` property set to the correct value based on the `action`. The `action` object should have","batch_seconds":24.456},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0129","target_sha256":"e47e7905eab0b893560ba1f2d91457d357d310b0b88c95dc77566f9078c48412","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":84.969},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0095","target_jaccard":0.2281,"instruction_nearest":"scale-rjct-react-isometric-game-0100","instruction_jaccard":0.439},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED"]}}
{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0130","messages":[{"role":"user","content":"Implement the `getIntoVehicle` function in the `GameMap` class, which takes a `GameMap` and an `action` object as parameters. The function should update the state to reflect the vehicle entering the map, including deoccupying the unit, entering the vehicle, setting the rotation, assigning the driver, and playing the appropriate sound effects"},{"role":"assistant","content":"export function getIntoVehicle(state: GameMap, action: GetIntoVehicleReducerAction) {\n  const { unit, vehicle } = action;\n\n  state.deOccupyCell(unit.getRoundedPosition());\n  unit.getIntoVehicle(vehicle);\n  unit.setRotation(vehicle.rotation, false);\n  vehicle.assignDriver(unit);\n\n  const turnOnSfx = state.createSfx([vehicle.dictEntity.sfx[\"turnOn\"].src], 1);\n  const idleSfx = state.createSfx([vehicle.dictEntity.sfx[\"idle\"].src], 1);\n\n  if (turnOnSfx) {\n    const stopTime = turnOnSfx.buffer!.duration * 1000 - 265;\n\n    if (idleSfx) {\n      window.setTimeout(() => {\n        vehicle.currentPlayingSfx[\"idle\"] = idleSfx;\n\n        idleSfx.loop = true;\n        idleSfx.start();\n      }, stopTime);\n    }\n\n    turnOnSfx.start();\n  }\n\n  // vehicle.currentPlayingSfx[]\n  //\n  // state.playSfx([vehicle.dictEntity.sfx[\"turnOn\"].src], 1, 0).then((a) => {\n  //   console.log(a);\n  //   state.playSfx([vehicle.dictEntity.sfx[\"idle\"].src], 1, 0);\n  // });\n\n  return { ...state };\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","GetIntoVehicleReducerAction"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/game/vehicle/getIntoVehicle.ts","source_lines":"11-45","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"getIntoVehicle","target_sha256":"3ad8868429366d512fc922d953fa38