{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0385","messages":[{"role":"user","content":"Implement the `upgradeTower` function in TypeScript, following the provided signature and constraints."},{"role":"assistant","content":"export function upgradeTower(w: World, t: Tower, path: UpgradePath): number {\n  const cost = upgradeCost(t, path)!;\n  t.tiers[path]++;\n  // A fresh object, never a mutation â€” in-flight projectiles hold the old one\n  // as their snapshot. See the field's comment in `types.ts`.\n  t.stats = computeStats(t.defId, t.tiers);\n  t.spent += cost;\n  w.money -= cost;\n  w.stats.spent += cost;\n  // Both an Overclock's range and its effect path change who it feeds and by\n  // how much, so an upgrade is a buff-graph change like a build or a sell.\n  refreshBuffs(w);\n  return cost;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","Tower","UpgradePath","A","See","Both","Overclock"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/build.ts","source_lines":"329-342","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"upgradeTower","target_sha256":"814d9ed7f6be56a672cb9c6671ede835624d384ba5af7dc8b0a466dd45b42ccb","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `upgradeTower` function in TypeScript, following the provided signature and constraints.\"\n}\n```","batch_seconds":19.572},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0385","target_sha256":"814d9ed7f6be56a672cb9c6671ede835624d384ba5af7dc8b0a466dd45b42ccb","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":84.969},"stratified_audit":null,"quality":{"method":"deterministic_contract_