{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0374","messages":[{"role":"user","content":"Implement the `toughestArmour` function in TypeScript to find the most powerful enemy in the game. The function should take a `World` object as input and return an `ArmourReference` object. If no enemy is found, it should return `null`. The function should also handle edge cases such as when there are no enemies or when"},{"role":"assistant","content":"export function toughestArmour(w: World): ArmourReference | null {\n  let best: ArmourReference | null = null;\n\n  for (const c of w.creeps) {\n    if (c.dead) continue;\n    const armor = ENEMIES[c.defId].armor;\n    if (armor > 0 && (best === null || armor > best.armor)) {\n      best = { defId: c.defId, armor, inbound: false };\n    }\n  }\n  if (best !== null) return best;\n\n  for (const spawn of planWave(w.seed, w.wave.index, w.rules, w.map.routes)) {\n    const armor = ENEMIES[spawn.enemy].armor;\n    if (armor > 0 && (best === null || armor > best.armor)) {\n      best = { defId: spawn.enemy, armor, inbound: true };\n    }\n  }\n  return best;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","ArmourReference","ENEMIES"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/analysis.ts","source_lines":"191-210","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"toughestArmour","target_sha256":"d9849ffb0fc8e367a2bb677689f011c65b88b7fbd02dcea7ad3d0776a70d7af1","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `toughestArmour` function in TypeScript to find the most powerful enemy in the game. The function should take a `World` object as input and return an `ArmourReference` object. If no enemy i