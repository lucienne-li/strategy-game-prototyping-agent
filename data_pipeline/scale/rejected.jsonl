{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0123","messages":[{"role":"user","content":"Implement the `startVehicleAcceleration` function in the `GameMap` class, which takes a `GameMap` and an `action` object as parameters. The function should enable acceleration for the vehicle and set its action to"},{"role":"assistant","content":"export function startVehicleAcceleration(state: GameMap, action: StartVehicleAccelerationReducerAction) {\n  const { vehicle, targetPosition } = action;\n\n  if (vehicle.accelerationEnabled) {\n    return state;\n  }\n\n  vehicle.accelerationEnabled = true;\n  vehicle.setAction(\"driving\");\n\n  const movement = calcMovementPath(vehicle, targetPosition);\n\n  vehicle.setPath(movement.path);\n  vehicle.setGearShiftMode(movement.gearShiftMode);\n\n  //\n  const shiftInSfx = state.createSfx([vehicle.dictEntity.sfx[\"shiftIn\"].src], 1);\n  const drivingInSfx = state.createSfx([vehicle.dictEntity.sfx[\"driving\"].src], 1);\n\n  if (shiftInSfx) {\n    if (vehicle.currentPlayingSfx[\"driving\"]) {\n      vehicle.currentPlayingSfx[\"driving\"]?.stop();\n      vehicle.currentPlayingSfx[\"driving\"]?.disconnect();\n    }\n\n    window.setTimeout(() => {\n      vehicle.currentPlayingSfx[\"idle\"]?.stop();\n      vehicle.currentPlayingSfx[\"idle\"]?.disconnect();\n      delete vehicle.currentPlayingSfx[\"idle\"];\n    }, 750);\n\n    const stopTime = 600;\n\n    if (drivingInSfx) {\n      window.setTimeout(() => {\n        vehicle.currentPlayingSfx[\"driving\"] = drivingInSfx;\n\n        drivingInSfx.loop = true;\n        drivingInSfx.start();\n      }, stopTime);\n    }\n\n    shiftInSfx.start();\n  }\n\n  return { ...state };\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GameMap","StartVehicleAccelerationReducerAction"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/reducers/game/vehicle/startVehicleAcceleration.ts","source_lines":"11-57","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G1","symbol":"startVehicleAcceleration","target_sha256":"146780f52d2a1e6f1e541d9a9eb633a837b477adc45af544a211709189304036","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `startVehicleAcceleration` function in the `GameMap` class, which takes a `GameMap` and an `action` object as parameters. The function should enable acceleration for the vehicle and set its action to \"driving\". It should also calculate the movement path based on the target position and update the vehicle's path and gear shift mode","batch_seconds":18.402},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0123","target_sha256":"146780f52d2a1e6f1e541d9a9eb633a837b477adc45af544a211709189304036","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":63.449},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-rjct-react-isometric-game-0100","target_jaccard":0.3182,"instruction_nearest":"scale-rjct-react-isometric-game-0100","instruction_jaccard":0.5143},"status":"rejected","rejection_reasons":["INSTRUCTION_TRUNCATED"]}}
{"schema_version":"1.0","sample_id":"scale-rjct-react-isometric-game-0124","messages":[{"role":"user","content":"Implement the `ObstacleRay` class with the following features:\n\n- A constructor that takes two `GridCoordinates` objects as input and initializes the ray's start and end positions.\n\n- A method to calculate the distance between the ray's start and end positions.\n\n- A method to calculate the distance to the ray's end position"},{"role":"assistant","content":"export class ObstacleRay {\n  public readonly from: GridCoordinates;\n  public readonly to: GridCoordinates;\n  public vector: GridCoordinates[] = [];\n  constructor(from: GridCoordinates, to: GridCoordinates, precision = false) {\n    this.from = precision ? { ...from } : { x: floor(from.x), y: floor(from.y) };\n    this.to = precision ? { ...to } : { x: floor(to.x), y: floor(to.y) };\n\n    this.cast();\n  }\n\n  getDistance(precision = false) {\n    const distance = getDistanceBetweenGridPoints(this.from, this.to);\n\n    return precision ? distance : floor(distance);\n  }\n\n  getDistanceToRayEndPosition(gameMap: GameMap, precision = false) {\n    const distance = getDistanceBetweenGridPoints(this.from, this.getRayEndPosition(gameMap));\n\n    return precision ? distance : floor(distance);\n  }\n\n  getAngle() {\n    return getAngleBetweenTwoGridPoints(this.from, this.to);\n  }\n\n  getRayEndPosition(gameMap: GameMap): GridCoordinates {\n    const targetPosition = { ...this.to };\n\n    for (const cell of this.vector) {\n      if (gameMap.isCellOccupied(cell)) {\n        targetPosition.x = Math.round(cell.x);\n        targetPosition.y = Math.round(cell.y);\n      }\n    }\n\n    return targetPosition;\n  }\n\n  private cast() {\n    const result: GridCoordinates[] = [];\n\n    let x1 = floor(this.from.x);\n    let y1 = floor(this.from.y);\n    const x2 = floor(this.to.x);\n    const y2 = floor(this.to.y);\n\n    const dx = Math.abs(x2 - x1);\n    const dy = Math.abs(y2 - y1);\n    const sx = x1 < x2 ? 1 : -1;\n    const sy = y1 < y2 ? 1 : -1;\n\n    let err = dx - dy;\n\n    while (!(x1 == x2 && y1 == y2)) {\n      const e2 = err << 1;\n\n      if (e2 > -dy) {\n        err -= dy;\n        x1 += sx;\n      }\n\n      if (e2 < dx) {\n        err += dx;\n        y1 += sy;\n      }\n\n      result.unshift({ x: x1, y: y1 });\n    }\n\n    this.vector = result;\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["GridCoordinates","GameMap"]},"metadata":{"source_repo":"rjct/react-isometric-game","source_commit":"54135db4c36972533e3c05117ef43513dc1597b4","source_path":"src/engine/light/ObstacleRayFactory.ts","source_lines":"4-77","repository_family_id":"github-family:rjct/react-isometric-game","license":"MIT","category":"tactics","granularity":"G2","symbol":"ObstacleRay","target_sha256":"b311fc3d8519c694bf033b3a46f3f5aaf7db19f8b3837636e767b9661a6c1e42","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `ObstacleRay` class with the following features:\\n\\n- A constructor that takes two `GridCoordinates` objects as input and initializes the ray's start and end positions.\\n\\n- A method to calculate the distance between the ray's start and end positions.\\n\\n- A method to calculate the distance to the ray's end position","batch_seconds":18.402},"independent_review":{"unit_id":"scale-rjct-react-isometric-game-0124","target_sha256":"b311fc3d8519c694bf033b3a46f3f5aaf7db19f8b3837636e767b9661a6c1e42","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":63.449},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-excaliburjs-sample-tactics-0084","target_jaccard":0.191,"instruction_nearest":"scale-rjct-react-isometric-game-0094","ins