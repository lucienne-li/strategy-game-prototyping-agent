{"schema_version":"1.0","sample_id":"scale-dezgusty-hexes-of-battle-0265","messages":[{"role":"user","content":"Implement the `CreatureRepository` class with methods to set abilities, create creatures, and manage creature templates."},{"role":"assistant","content":"export class CreatureRepository {\n  abilities: Ability[] = [];\n  creatureTemplates: CreatureTemplate[] = [];\n  nameToTypesMap: Map<CreatureType, string> = new Map<CreatureType, string>([\n    [CreatureType.PEASANT, \"peasant\"],\n    [CreatureType.PEASANT_ARCHER, \"peasant-archer\"],\n    [CreatureType.SWORDSMAN, \"swordsman\"],\n    [CreatureType.SPEARMAN, \"spearman\"],\n    [CreatureType.CROSSBOWMAN, \"crossbowman\"],\n    [CreatureType.BARBARIAN, \"barbarian\"]\n  ]);\n\n  constructor() { }\n\n  setAbilities(abilities: Ability[]) {\n    this.abilities = abilities;\n  }\n\n  setCreatureTemplates(templates: CreatureTemplate[]) {\n    this.creatureTemplates = templates;\n  }\n\n  createCreature(creatureType: CreatureType): Creature {\n\n    // get the creature type name based on the creature type\n    const creatureTypeName = this.nameToTypesMap.get(creatureType);\n\n    // find the template by the creature name\n    const creatureTemplate = this.creatureTemplates.find(template => template.name === creatureTypeName);\n    if (!creatureTemplate) {\n      throw new Error(`Could not find creature template for creature type ${creatureType}`);\n    }\n\n    let result = new Creature(creatureType, { ...creatureTemplate.stats }, []);\n    result.stats.remaining_ammo = result.stats.ammo;\n    result.stats.remaining_attacks = result.stats.num_attacks;\n    result.stats.remaining_counterattacks = result.stats.num_counterattacks;\n    result.stats.remaining_health = result.stats.health;\n    result.stats.remaining_movement = result.stats.num_moves;\n\n    result.abilities = creatureTemplate.ability_ids.map(abilityId => {\n      const ability = this.abilities.find(ability => ability.id === abilityId);\n      if (!ability) {\n        return null;\n      }\n      return ability;\n    }).filter(ability => ability !== null) as Ability[];\n\n    return result;\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["Ability","CreatureTemplate","CreatureType","PEASANT","PEASANT_ARCHER","SWORDSMAN","SPEARMAN","CROSSBOWMAN","BARBARIAN","Creature","Error","Could"]},"metadata":{"source_repo":"dezGusty/hexes-of-battle","source_commit":"fec1d7ee8178cb88ff1b77b6166d502fabde5418","source_path":"src/battle/creature-repository.ts","source_lines":"4-54","repository_family_id":"github-family:dezGusty/hexes-of-battle","license":"MIT","category":"tactics","granularity":"G2","symbol":"CreatureRepository","target_sha256":"1fb421da3791b69df98caafcaad47415e228e95a6e2db49f61f08fecd5c8cbe4","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `CreatureRepository` class with methods to set abilities, create creatures, and manage creature templates.\"\n}\n```","batch_seconds":21.456},"independent_review":{"unit_id":"scale-dezgusty-hexes-of-battle-0265","target_sha256":"1fb421da3791b69df98caafcaad47415e228e95a6e2db49f61f08fecd5c8cbe4","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":79.734},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-excaliburjs-sample-tactics-0084","target_jaccard":0.14,"instruction_nearest":"scale-darellanodev-gif-tower-defense-0322","instruction_jaccard":0.2727},"status":"rejected","rejection_reasons":["SOURCE_LEAKAGE_LANGUAGE"]}}
{"schema_version":"1.0","sample_id":"scale-djpav-threejs-tower-defense-0417","messages":[{"role":"user","content":"Implement the `WaypointMovement` class in TypeScript, ensuring it adheres to the specified guidelines. The class should include methods for updating the movement state, getting the progress, and resetting the waypoint index."},{"role":"assistant","content":"export class WaypointMovement implements EnemyMovementStrategy {\n  private waypoints: WorldPosition[];\n  private waypointIndex = 0;\n\n  constructor(waypoints: WorldPosition[]) {\n    this.waypoints = waypoints;\n    this.waypointIndex = waypoints.length > 0 ? 1 : 0;\n  }\n\n  update(delta: number, state: MovementState): MovementResult {\n    if (this.waypointIndex >= this.waypoints.length) {\n      return { reachedGoal: true };\n    }\n\n    const effectiveSpeed = state.speed * state.slowFactor;\n    let remaining = effectiveSpeed * delta;\n\n    while (remaining > 0 && this.waypointIndex < this.waypoints.length) {\n      const target = this.waypoints[this.waypointIndex];\n      const dx = target.x - state.x;\n      const dz = target.z - state.z;\n      const dist = Math.sqrt(dx * dx + dz * dz);\n\n      if (dist <= remaining) {\n        state.x = target.x;\n        state.z = target.z;\n        this.waypointIndex++;\n        remaining -= dist;\n      } else {\n        state.x += (dx / dist) * remaining;\n        state.z += (dz / dist) * remaining;\n        remaining = 0;\n      }\n    }\n\n    return { reachedGoal: this.waypointIndex >= this.waypoints.length };\n  }\n\n  getProgress(currentX: number, currentZ: number): number {\n    if (this.waypointIndex >= this.waypoints.length) return this.waypoints.length;\n    const target = this.waypoints[this.waypointIndex];\n    const dx = target.x - currentX;\n    const dz = target.z - currentZ;\n    const distToNext = Math.sqrt(dx * dx + dz * dz);\n    return this.waypointIndex + (1 - Math.min(distToNext, 1));\n  }\n\n  getWaypointIndex(): number {\n    return this.waypointIndex;\n  }\n\n  getWaypoints(): WorldPosition[] {\n    return this.waypoints;\n  }\n\n  setPositionAndProgress(_x: number, _z: number, wpIndex: number): void {\n    // Position is set externally on the group; we just track waypoint index\n    this.waypointIndex = Math.min(wpIndex, this.waypoints.length);\n  }\n\n  reset(waypoints: WorldPosition[]): void {\n    this.waypoints = waypoints;\n    this.waypointIndex = waypoints.length > 0 ? 1 : 0;\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["EnemyMovementStrategy","WorldPosition","MovementState","MovementResult","Position"]},"metadata":{"source_repo":"djpav/threejs-tower-defense","source_commit":"dcb33e163c96e03d464d868b5b91ca5af93fe4f2","source_path":"src/entities/components/EnemyMovement.ts","source_lines":"36-100","repository_family_id":"github-family:djpav/threejs-tower-defense","license":"MIT","category":"tower-defense","granularity":"G2","symbol":"WaypointMovement","target_sha256":"fbbbcfff40f419b62c0c6e1e56aebee39991be5fbf21911c782a4de16f82171c","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `WaypointMovement` class in TypeScript, ensuring it adheres to the specified guidelines. The class should include methods for updating the movement state, getting the progress, and resetting the waypoint index.\"\n}\n```","batch_seconds":27.243},"independent_review":{"unit_id":"scale-djpav-threejs-tower-defense-0417","target_sha256":"fbbbcfff40f419b62c0c6e1e56aebee39991be5fbf21911c782a4de16f82171c","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":79.734},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-cbhead-deep-field-td-0369","target_jaccard":0.179