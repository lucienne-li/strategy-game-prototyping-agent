{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0394","messages":[{"role":"user","content":"Implement the `renderTop` function in TypeScript, following the provided guidelines."},{"role":"assistant","content":"function renderTop(w: World, speed: number, paused: boolean): string {\n  const s = w.wave;\n  // An endless arc has no denominator â€” see `heldLabel`. On Front Line, waves\n  // held is a score rather than progress toward anything, because there is\n  // nothing to be partway through.\n  const held = heldLabel(w);\n\n  let label: string;\n  let fill: number;\n  if (s.phase === 'intermission') {\n    label = `wave ${s.index + 1} Â· in ${Math.ceil(s.timer)}s`;\n    fill = 1 - Math.max(0, s.timer) / BALANCE.intermission;\n  } else if (s.phase === 'spawning') {\n    // A contact glyph rather than the word \"alive\": the deck is teaching this\n    // vocabulary two rows down, and one dot the player already recognises beats\n    // a noun. Not three anonymous dots, which invite reading \"3 alive\".\n    label =\n      `wave ${s.index + 1} Â· <i class=\"dot contact\"></i>${aliveInWave(w, s.index)}` +\n      ` of ${s.plan.length}`;\n    fill = s.plan.length === 0 ? 0 : s.spawned / s.plan.length;\n  } else {\n    label = 'last wave out';\n    fill = 1;\n  }\n\n  // The alarm is the width of the screen rather than one red digit, because a\n  // player at four lives is looking at the board, not at the stat cells â€” and\n  // the collapsed deck's status strip, which used to carry this, is gone.\n  //\n  // The fill's *geometry* is untouched: `--ribbon` recolours it, so it still\n  // reads as a progress value rather than as a second quantity. If it ever\n  // starts reading as \"42% doomed\", drop `.crit` to a rim and border only and\n  // leave the fill on the accent.\n  const crit = w.lives <= BALANCE.critLives;\n\n  const speeds = SPEEDS.map(\n    (v) =>\n      `<button data-act=\"speed\" data-v=\"${v}\" class=\"${v === speed ? 'on' : ''}\">${v}Ã—</button>`,\n  ).join('');\n\n  return (\n    // No sigil. Costs lost theirs in the deck, and a currency mark repeated on\n    // every price is a character the player has already agreed to.\n    `<div class=\"stat\"><label>Cash</label><b>${w.money}</b></div>` +\n    `<div class=\"stat\"><label>Lives</label><b class=\"${crit ? 'crit' : ''}\">${w.lives}</b></div>` +\n    `<div class=\"stat\"><label>Waves held</label><b>${held}</b></div>` +\n    renderEraRail(w) +\n    `<div class=\"ribbon${crit ? ' crit' : ''}\"><span>${label}</span>` +\n    `<i style=\"width:${(clamp01(fill) * 100).toFixed(1)}%\"></i></div>` +\n    `<div class=\"seg speeds\">${speeds}</div>` +\n    // aria-label rather than title: the glyph is universal, Esc means nothing\n    // on a touch device, and a tooltip that never fires there is dead weight.\n    `<button class=\"icon\" data-act=\"pause\" aria-label=\"${paused ? 'Resume' : 'Pause'}\">` +\n    `${paused ? 'â–¶' : 'âšâš'}</button>`\n  );\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","An","On","Front","Line","BALANCE","A","Not","The","If","SPEEDS","No"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/ui/hud.ts","source_lines":"392-447","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"renderTop","target_sha256":"7c31dd359ae201b92beb12149eb6c9d55888ce507c870ffb1c01e30ec47d50ab","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `renderTop` function in TypeScript, following the provided guidelines.\"\n}\n```","batch_seconds":27.84},"independent_review":{"unit_id":"scale-cbhead-deep-field-td-0394","target_sha256":"7c31dd359ae201b92beb12149eb6c9d55888ce507c870ffb1c01e30ec47d50ab","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":61.113},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-cbhead-deep-field-td-0371","target_jaccard":0.2294,"instruction_nearest":"scale-cbhead-deep-field-td-0393","instruction_jaccard":0.3333},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
