{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0228","messages":[{"role":"user","content":"Serialize the `serializeBattleTurn` function in TypeScript, ensuring it adheres to the specified guidelines."},{"role":"assistant","content":"export function serializeBattleTurn(\n  battle: BattleState,\n  side: Side,\n  vista: VistaDeBatalla,\n): unknown {\n  const stackView = (s: (typeof battle.stacks)[number]) => {\n    const info = creature(s.creature);\n    return {\n      id: s.id,\n      side: s.side,\n      creature: s.creature,\n      name: info.name,\n      count: s.count,\n      hp: stackHp(s),\n      hex: s.hex,\n      occupies: stackHexes(s),\n      speed: stackSpeed(s),\n      attack: info.attack,\n      defense: info.defense,\n      damage: info.damage,\n      shooter: isShooter(info),\n      shotsLeft: s.shotsLeft,\n      traits: info.traits ?? [],\n      // La suerte va ya con los efectos aplicados: el contrato promete el\n      // valor con el que se va a tirar, no el de la ficha. La moral no tiene\n      // efectos temporales que aplicar, asÃ­ que es la suya y ya.\n      morale: s.morale,\n      luck: effectiveLuck(s),\n      // Y aparte, cuÃ¡nto le queda a cada cosa: sin esto el agente ve el nÃºmero\n      // cambiar de una ronda a otra sin saber por quÃ© ni hasta cuÃ¡ndo.\n      effects: s.effects.map((e) => ({\n        kind: e.kind,\n        amount: e.amount,\n        source: e.source,\n        roundsLeft: e.roundsLeft,\n      })),\n      defending: s.defending,\n      waited: s.waited,\n    };\n  };\n\n  const hero = battle.heroes[side];\n  const propia = vista === 'propia';\n  const activo = activeStack(battle);\n\n  return {\n    kind: 'battle_turn',\n    round: battle.round,\n    yourSide: side,\n    activeStack: battle.activeId,\n    board: { width: 11, height: 9, layout: 'offset odd-r; el atacante entra por la columna 0' },\n    stacks: battle.stacks.filter((s) => s.count > 0).map(stackView),\n    hero:\n      hero === null\n        ? null\n        : {\n            name: hero.name,\n            attack: hero.attack,\n            defense: hero.defense,\n            spellPower: hero.spellPower,\n            castThisRound: hero.castThisRound,\n            // Los dos Ãºnicos campos del bando, juntos y en una lÃ­nea que se lee:\n            // con quÃ© manÃ¡ cuenta y quÃ© sabe lanzar. De un hÃ©roe ajeno no salen.\n            ...(propia ? { mana: hero.mana, spells: hero.spells } : {}),\n          },\n    // Todas las acciones legales del stack activo: elegir una nunca falla â€”\n    // cuando te toca. Si el stack activo no es de `side`, esta lista es la de\n    // OTRO y sus `cast` son su libro y su manÃ¡: no se manda.\n    ...(propia && activo !== null && activo.side === side\n      ? { legalActions: legalActions(battle) }\n      : {}),\n    log: battle.log.slice(-30),\n  };\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["BattleState","Side","VistaDeBatalla","La","Y","Los","De","Todas","Si","OTRO"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/core/contract/serialize.ts","source_lines":"378-451","repository_family_id":"github-family:alberto-hortelano/heroes-of-silence","license":"MIT","category":"tactics","granularity":"G1","symbol":"serializeBattleTurn","target_sha256":"ef221e049cfeec918cd6248392d44e20c06cacf8d4680271c462744e7357d78b","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Serialize the `serializeBattleTurn` function in TypeScript, ensuring it adheres to the specified guidelines.\"\n}\n```","batch_seconds":25.019},"independent_review":{"unit_id":"scale-alberto-hortelano-heroes-of-silence-0228","target_sha256":"ef221e049cfeec918cd6248392d44e20c06cacf8d4680271c462744e7357d78b","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse