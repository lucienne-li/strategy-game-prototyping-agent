{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0387","messages":[{"role":"user","content":"Implement the `beginWave` function in TypeScript, following the provided signature and potential provided symbols. The function should handle the wave spawning process, including capturing before the timer is reset, and reward the player based on the time saved."},{"role":"assistant","content":"export function beginWave(w: World): void {\n  const s = w.wave;\n\n  if (s.phase === 'spawning') {\n    w.events.push({ type: 'waveRejected', reason: 'spawning' });\n    return;\n  }\n  if (s.phase === 'done') {\n    w.events.push({ type: 'waveRejected', reason: 'done' });\n    return;\n  }\n\n  // Captured before the timer is reset. The auto-start path arrives here with\n  // the timer already at or below zero, so it earns nothing â€” the bonus is\n  // strictly payment for time the player chose to give up.\n  const secondsSaved = Math.max(0, s.timer);\n\n  s.plan = planWave(w.seed, s.index, w.rules, w.map.routes);\n  s.spawned = 0;\n  s.timer = 0;\n  s.phase = 'spawning';\n  w.events.push({ type: 'waveStarted', wave: s.index, count: s.plan.length });\n\n  if (secondsSaved > 0) {\n    const bonus = Math.round(secondsSaved * BALANCE.rushBonusPerSecond);\n    w.money += bonus;\n    w.events.push({ type: 'waveRushed', wave: s.index, bonus, secondsSaved });\n  }\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","Captured","The","BALANCE"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/systems/waves.ts","source_lines":"18-46","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"beginWave","target_sha256":"6e19ab4476faf7c26a9de0615f06c3b6abb01bb8716ddcd58607fd968af2fdff","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":tru