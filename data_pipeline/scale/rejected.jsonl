{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0388","messages":[{"role":"user","content":"Update the waves in the game world based on the current time and the wave rules."},{"role":"assistant","content":"export function updateWaves(w: World, dt: number): void {\n  const s = w.wave;\n\n  switch (s.phase) {\n    case 'intermission':\n      s.timer -= dt;\n      if (s.timer <= 0) beginWave(w);\n      break;\n\n    case 'spawning': {\n      s.timer += dt;\n      // A `while`, not an `if`: at 4x speed, or with a tight rush wave, more\n      // than one spawn can come due in a single 16ms tick.\n      while (s.spawned < s.plan.length && s.plan[s.spawned]!.at <= s.timer) {\n        const next = s.plan[s.spawned]!;\n        spawnCreep(w, next.enemy, {\n          hp: next.hp,\n          bounty: next.bounty,\n          shield: next.shield,\n          wave: s.index,\n          route: next.route,\n        });\n        s.spawned++;\n      }\n\n      if (s.spawned >= s.plan.length) {\n        s.dispatchedThrough = s.index;\n        // The intermission starts now, not when the board empties. This is what\n        // makes waves overlap.\n        if (s.index + 1 >= waveCount(w.rules)) {\n          s.phase = 'done';\n        } else {\n          s.index++;\n          s.phase = 'intermission';\n          s.timer = BALANCE.intermission;\n        }\n      }\n      break;\n    }\n\n    case 'done':\n      break;\n  }\n\n  settleClearedWaves(w);\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","A","The","This","BALANCE"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/systems/waves.ts","source_lines":"48-93","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"updateWaves","target_sha256":"a86d15186394f456f8970ab3b0210e951c761ee76ec848443c05a6eed7466fa3","generation":{"model":"Qwen/Qwen2.5