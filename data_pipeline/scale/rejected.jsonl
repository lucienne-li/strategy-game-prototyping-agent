{"schema_version":"1.0","sample_id":"scale-alberto-hortelano-heroes-of-silence-0237","messages":[{"role":"user","content":"Implement the `strike` function in TypeScript, following the provided signature and instructions."},{"role":"assistant","content":"function strike(\n  state: BattleState,\n  attacker: BattleStack,\n  target: BattleStack,\n  rng: Rng,\n  retaliation: boolean,\n  hexesMoved: number,\n): void {\n  const info = creature(attacker.creature);\n  const result = computeDamage(\n    attacker,\n    state.heroes[attacker.side],\n    target,\n    state.heroes[target.side],\n    rng,\n    { chargeHexes: hexesMoved },\n  );\n  const killed = applyDamage(target, result.damage);\n\n  if (result.lucky) state.log.push({ kind: 'luck', stack: attacker.id, good: true });\n  if (result.unlucky) state.log.push({ kind: 'luck', stack: attacker.id, good: false });\n\n  state.log.push({\n    kind: 'attack',\n    stack: attacker.id,\n    target: target.id,\n    damage: result.damage,\n    killed,\n    retaliation,\n    // La carga la dice `computeDamage`, que es quien la cobrÃ³: preguntarlo otra\n    // vez aquÃ­ dejaba el parte contando 7 hexes mientras el bono se habÃ­a\n    // topado en los 5 que caben en +50 %.\n    ...(result.charge > 0 ? { charge: result.charge } : {}),\n  });\n\n  // Los vampiros seÃ±ores recuperan efectivos con lo que drenan.\n  if (hasTrait(info, 'life_drain') && !retaliation) {\n    healFromDrain(attacker, result.damage);\n  }\n\n  // Lo que el golpe deja pegado. Va ANTES del contraataque a propÃ³sito: al\n  // dragÃ³n Ã³seo le devuelven el golpe ya asustados, que es donde se nota.\n  // Un contraataque no asusta ni maldice: solo el que ataca de verdad.\n  if (!retaliation && isAlive(target)) {\n    for (const { trait, effect } of ON_HIT_EFFECTS) {\n      if (hasTrait(info, trait)) applyStackEffect(state, target, effect);\n    }\n  }\n\n  if (!isAlive(target)) state.log.push({ kind: 'perished', stack: target.id });\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["BattleState","BattleStack","Rng","La","Los","Lo","Va","ANTES","Un","ON_HIT_EFFECTS"]},"metadata":{"source_repo":"alberto-hortelano/heroes-of-silence","source_commit":"39a68765ebe554c646d0d22d2f85ff8dc51d67ed","source_path":"src/core/battle/battle.ts","source_lines":"595-645","repository_family_id":"github-family:alberto-hortelano/heroes-of-silence","license":"MIT","category":"tactics","granularity":"G1","symbol":"strike","target_sha256":"0bdeae5713de198fdc191e7a98521bf307b348f04d7a343b4125a216cac4d8a8","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `strike` function in TypeScript, following the provided signature and instructions.\"\n}\n```","batch_seconds":21.429},"independent_review":{"unit_id":"scale-alberto-hortelano-heroes-of-silence-0237","target_sha256":"0bdeae5713de198fdc191e7a98521bf307b348f04d7a343b4125a216cac4d8a8","reviewer":"Qwen/Qwen2.5-Coder-0.5B-Instruct","label":"PASS","parse_valid":true,"raw_output":"PASS","batch_seconds":84.969},"stratified_audit":null,"quality":{"method":"deterministic_contract_and_similarity_gates","alignment":"pass","granularity_match":"pass","solvability":"pass","target_nearest":"scale-alberto-hortelano-heroes-of-silence-0225","target_jaccard":0.145,"instruction_nearest":"scale-rjct-react-isometric-game-0104","instruction_jaccard":0.2632},"status":"rejected","rejection_reasons":["UNDERSPECIFIED_REFERENCE"]}}
{"schema_version":"1.0","sample_id":"scale-baterson-svelte-tower-defence-0286","messages":[{"role":"user","content":"Implement the `FollowTarget` class in TypeScript, following the provided signature and providing a detailed description of its observable inputs, outputs, state changes, filtering, and edge cases."},{"role":"assistant","content":"export class FollowTarget extends BaseState {\n\tprivate lastAngle = 0;\n\tprivate rotationOffset = 90; // Offset for sprite orientation\n\n\tupdate(deltaTime: number) {\n\t\tconst { target } = this.stateMachine.context;\n\n\t\tif (target?.isInteractable) {\n\t\t\tthis.followTarget(deltaTime, target);\n\t\t} else {\n\t\t\tthis.stateMachine.setState('FollowAngle', {\n\t\t\t\tangle: this.lastAngle\n\t\t\t});\n\t\t}\n\t}\n\n\tgetTopMiddlePoint(entity): Vector2 {\n\t\tconst boundingBox = boundingBoxFromPoint(entity.position, entity.width, entity.height);\n\t\treturn boundingBox.topMiddle;\n\t}\n\n\tfollowTarget(deltaTime: number, target: any) {\n\t\tconst entityCenter = this.entity.boundingBox.center;\n\t\tconst targetTopMiddle = this.getTopMiddlePoint(target);\n\n\t\t// Calculate angle from entity center to target's top middle point\n\t\tthis.lastAngle = angleToTarget(entityCenter, target.boundingBox.center);\n\n\t\t// Update entity rotation with offset\n\t\tthis.entity.rotation = (this.lastAngle * 180) / Math.PI + this.rotationOffset;\n\n\t\t// Get movement direction from the angle\n\t\tconst direction = getDirectionFromAngle(this.lastAngle);\n\n\t\t// Calculate velocity\n\t\tconst velocity = direction.multiply(this.entity.stats.speed * deltaTime);\n\n\t\t// Update the entity position\n\t\tthis.entity.position = this.entity.position.add(velocity);\n\t}\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["BaseState","Offset","FollowAngle","Vector2","Calculate","Update","PI","Get"]},"metadata":{"source_repo":"baterson/svelte-tower-defence","source_commit":"158cd98dbf81ab08a3abaa9b5d00b43b16ffe41a","source_path":"src/li