{"schema_version":"1.0","sample_id":"scale-cbhead-deep-field-td-0386","messages":[{"role":"user","content":"Implement the `buildTower` function in TypeScript, following the provided signature and constraints."},{"role":"assistant","content":"export function buildTower(w: World, defId: TowerId, col: number, row: number): Tower {\n  const def = TOWERS[defId];\n  const centre = tileCentre(col, row);\n\n  const tiers: TowerTiers = { damage: 1, range: 1, effect: 1 };\n  const tower: Tower = {\n    id: w.nextId++,\n    defId,\n    col,\n    row,\n    x: centre.x,\n    y: centre.y,\n    tiers,\n    stats: computeStats(defId, tiers),\n    // Filled in by the `refreshBuffs` below, which also covers this station\n    // being placed *into* an existing Overclock's reach.\n    buffShots: 0,\n    targeting: 'first',\n    // Ready to fire the moment it lands, so a last-second build still helps.\n    cooldown: 0,\n    focusId: null,\n    focusTime: 0,\n    spent: def.cost,\n    kills: 0,\n    damageDealt: 0,\n  };\n\n  w.money -= def.cost;\n  w.stats.spent += def.cost;\n  w.towers.push(tower);\n  refreshBuffs(w);\n  return tower;\n}\n"}],"context":{"language":"TypeScript","provided_symbols":["World","TowerId","Tower","TOWERS","TowerTiers","Filled","Overclock","Ready"]},"metadata":{"source_repo":"cbhead/deep-field-td","source_commit":"a2bbdac19ea936c0e1eb9f4d0a3c5cbb576a64a5","source_path":"src/sim/build.ts","source_lines":"294-326","repository_family_id":"github-family:cbhead/deep-field-td","license":"MIT","category":"tower-defense","granularity":"G1","symbol":"buildTower","target_sha256":"be3e6e9e0d2ed09362d781659d3ce4047c6c629bd053daf2d0d826d70e844617","generation":{"model":"Qwen/Qwen2.5-Coder-0.5B-Instruct","method":"code_to_instruction","decode":"greedy","parse_valid":true,"raw_output":"```json\n{\n  \"instruction\": \"Implement the `buildTower` function in TypeScript, following the provided signature and constraints.\"\n}\n```","batch_seconds":19.572},"independent_review":{"u